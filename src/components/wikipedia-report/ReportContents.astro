---
// The full table of contents on the reader index: every page after the
// executive summary, each with its depth-2 headings. Rows follow the
// numbered-list rhythm of the key findings on /wikipedia-report.
import { focusRing } from "../../utils/designClasses";
import { entryHref, entryShortLabel, groupToc, type ReportEntryMeta } from "./reportNav";

interface Props {
  entries: ReportEntryMeta[];
  headingId: string;
}

const { entries, headingId } = Astro.props;
---

<ol aria-labelledby={headingId} class="border-b border-ink-divider">
  {
    entries.map((entry) => {
      const groups = groupToc(entry.toc);
      return (
        <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 border-t border-ink-divider py-6 min-[810px]:grid-cols-[3.5rem_minmax(0,1fr)] min-[810px]:py-7">
          <span
            aria-hidden="true"
            class="pt-0.5 text-[17px] font-bold tabular-nums text-ink-muted min-[810px]:text-[19px]"
          >
            {entryShortLabel(entry)}
          </span>
          <div class="min-w-0">
            <a
              href={entryHref(entry.slug)}
              class={`inline-block rounded-sm text-[21px] font-extrabold leading-snug text-ink transition-colors hover:text-grove motion-reduce:transition-none min-[810px]:text-[24px] ${focusRing}`}
            >
              {entry.label && <span class="sr-only">{entry.label}: </span>}
              {entry.title}
            </a>
            {groups.length > 0 && (
              <ol class="mt-3 max-w-[60ch] space-y-1">
                {groups.map((group) => (
                  <li class="text-[16px] leading-snug">
                    <a
                      href={`${entryHref(entry.slug)}#${group.id}`}
                      class={`inline-block rounded-sm py-0.5 text-ink-secondary transition-colors hover:text-grove motion-reduce:transition-none ${focusRing}`}
                    >
                      {group.number && (
                        <span class="mr-2 font-bold tabular-nums">{group.number}</span>
                      )}
                      {group.title}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
