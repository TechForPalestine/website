---
// Client behaviour for the reader pages, bundled by Astro (so it carries the
// CSP nonce like every other module script):
//   1. Plausible "Wikipedia Report Download" events on [data-track-report-download],
//      mirroring /wikipedia-report so both pages report into one goal.
//   2. Current-heading highlight in the sidebar outline, which also collapses
//      depth-3 headings to the group being read. Without JS the outline shows
//      every heading and nothing is highlighted.
---

<script>
  document.querySelectorAll<HTMLElement>("[data-track-report-download]").forEach((link) => {
    link.addEventListener("click", () => {
      if (typeof window.plausible === "undefined") return;
      window.plausible("Wikipedia Report Download", {
        props: { location: link.dataset.trackReportDownload ?? "unknown" },
      });
    });
  });

  // A heading counts as "current" once its top passes this line, just under
  // the sticky nav.
  const ACTIVATION_OFFSET_PX = 128;

  function initOutline(outline: HTMLElement): void {
    const links = Array.from(outline.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((heading): heading is HTMLElement => heading !== null);
    if (headings.length === 0) return;

    outline.dataset.enhanced = "";
    const scroller = outline.closest<HTMLElement>("[data-outline-scroller]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeId: string | null = null;

    function currentHeadingId(): string | null {
      let current: string | null = null;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top - ACTIVATION_OFFSET_PX > 0) break;
        current = heading.id;
      }
      return current;
    }

    function keepInView(link: HTMLElement): void {
      if (!scroller) return;
      const linkBox = link.getBoundingClientRect();
      const box = scroller.getBoundingClientRect();
      if (linkBox.top >= box.top && linkBox.bottom <= box.bottom) return;
      // Scroll only the sidebar, never the page.
      scroller.scrollTo({
        top: scroller.scrollTop + linkBox.top - box.top - box.height / 3,
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    }

    function update(): void {
      const id = currentHeadingId();
      if (id === activeId) return;
      activeId = id;

      for (const link of links) {
        if (link.dataset.tocLink === id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
      const activeLink = links.find((link) => link.dataset.tocLink === id);
      outline.querySelectorAll<HTMLElement>("[data-toc-group]").forEach((group) => {
        if (activeLink && group.contains(activeLink)) group.dataset.open = "";
        else delete group.dataset.open;
      });
      if (activeLink) keepInView(activeLink);
    }

    // The observer only signals that something crossed the line; update()
    // then works out which heading is current from positions.
    const observer = new IntersectionObserver(update, {
      rootMargin: `-${ACTIVATION_OFFSET_PX}px 0px 0px 0px`,
    });
    headings.forEach((heading) => observer.observe(heading));
    update();
  }

  document.querySelectorAll<HTMLElement>("[data-report-outline]").forEach(initOutline);
</script>
