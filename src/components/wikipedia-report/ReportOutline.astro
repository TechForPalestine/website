---
// The reader's navigation: every page of the report in order, with the
// current page's headings beneath it (every entry's headings on the full
// page). Rendered twice by ReportShell: as the sticky rail on md+
// (`variant="sidebar"`, depth-3 headings included) and in the phone drawer /
// no-JS <details> (`variant="compact"`, depth-2 only).
//
// In the sidebar every group with children ([data-toc-group]: a depth-2
// heading, or on the full page an entry) gets a chevron toggle. Without JS the
// toggles are hidden by CSS and every group shows expanded; ReportScripts
// reveals them and drives open/closed state (see outlineGroups.ts).
//
// On the full page the entry links carry data-toc-link too, so the entry
// itself is highlighted while its opening text (before its first heading) is
// on screen, rather than the previous entry's last heading.
import { Icon } from "astro-icon/components";
import { focusRing } from "../../utils/designClasses";
import OutlineCollapse from "./OutlineCollapse.astro";
import { REPORT_BASE_PATH } from "../../utils/wikipediaReportLinks";
import {
  entryHref,
  entryShortLabel,
  groupToc,
  INDEX_SLUG,
  type ReportEntryMeta,
} from "./reportNav";
import { REPORT_PDF_HREF, READER_SUBTITLE, READER_TITLE } from "./reportMeta";

interface Props {
  entries: ReportEntryMeta[];
  currentSlug: string;
  variant: "sidebar" | "compact";
  /** "single": every entry is an anchor on one page and all headings are listed. */
  mode?: "pages" | "single";
}

const { entries, currentSlug, variant, mode = "pages" } = Astro.props;
const isSingle = mode === "single";
const isSidebar = variant === "sidebar";

const itemLink = `flex gap-3 rounded-sm py-1.5 text-[15px] leading-snug transition-colors hover:text-grove motion-reduce:transition-none ${focusRing}`;
const headingLinkBase = `block rounded-sm py-1 leading-snug text-ink-secondary transition-colors hover:text-grove motion-reduce:transition-none ${focusRing}`;
const headingLink = `${headingLinkBase} text-[14px]`;
const childLink = `${headingLinkBase} text-[13px]`;
const toggleClass = `report-toc-toggle grid h-7 w-7 shrink-0 place-items-center rounded-sm text-ink-muted transition-colors hover:text-grove motion-reduce:transition-none ${focusRing}`;
const chevron = "M9 6l6 6-6 6";
---

<nav
  aria-label="Report contents"
  data-report-outline={isSidebar ? "" : undefined}
  data-outline-compact={isSidebar ? undefined : ""}
  class="report-no-print text-ink"
>
  {
    isSidebar && (
      <a
        href={REPORT_BASE_PATH}
        class={`block rounded-sm text-[17px] font-extrabold leading-tight text-ink transition-colors hover:text-grove motion-reduce:transition-none ${focusRing}`}
      >
        {READER_TITLE}
        <span class="block font-normal text-ink-secondary">{READER_SUBTITLE}</span>
      </a>
    )
  }

  <ol class:list={["space-y-0.5", isSidebar && "mt-6 border-t border-ink-divider pt-4"]}>
    {
      entries.map((entry) => {
        const isCurrent = !isSingle && entry.slug === currentSlug;
        const short = entryShortLabel(entry);
        const groups = isCurrent || isSingle ? groupToc(entry.toc) : [];
        // On the full page each entry is itself a collapsible group.
        const entryGroupId =
          isSidebar && isSingle && groups.length > 0 ? `entry-${entry.slug}` : undefined;
        return (
          <li data-toc-group={entryGroupId}>
            <div class="flex items-start gap-1">
              <a
                href={isSingle ? `#${entry.slug}` : entryHref(entry.slug)}
                aria-current={isCurrent ? "page" : undefined}
                data-toc-link={isSingle ? entry.slug : undefined}
                class:list={[
                  itemLink,
                  "min-w-0 flex-1",
                  isCurrent ? "font-bold text-ink" : "text-ink-secondary",
                ]}
              >
                <span
                  class:list={[
                    "w-5 shrink-0 font-bold tabular-nums",
                    isCurrent ? "text-grove" : "text-ink-muted",
                  ]}
                  aria-hidden="true"
                >
                  {short ?? (entry.slug === INDEX_SLUG ? "·" : "")}
                </span>
                <span class="min-w-0">
                  {short && <span class="sr-only">{entry.label}: </span>}
                  {entry.title}
                </span>
              </a>
              {entryGroupId && (
                <button
                  type="button"
                  data-toc-toggle
                  aria-expanded="true"
                  aria-controls={`toc-sub-${entryGroupId}`}
                  aria-label={`${entry.title}: headings`}
                  class:list={[toggleClass, "mt-1"]}
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={chevron} />
                  </svg>
                </button>
              )}
            </div>

            {groups.length > 0 && (
              <OutlineCollapse
                id={entryGroupId && `toc-sub-${entryGroupId}`}
                enabled={entryGroupId !== undefined}
              >
                <ol class="mb-3 ml-8 mt-1 space-y-0.5 border-l border-ink-divider pl-3">
                  {groups.map((group) => {
                    const hasToggle = isSidebar && group.children.length > 0;
                    return (
                      <li data-toc-group={hasToggle ? group.id : undefined}>
                        <div class="flex items-start gap-1">
                          <a
                            href={`#${group.id}`}
                            data-toc-link={group.id}
                            class:list={[headingLink, "min-w-0 flex-1"]}
                          >
                            {group.number && (
                              <span class="mr-1.5 font-bold tabular-nums">{group.number}</span>
                            )}
                            {group.title}
                          </a>
                          {hasToggle && (
                            <button
                              type="button"
                              data-toc-toggle
                              aria-expanded="true"
                              aria-controls={`toc-sub-${group.id}`}
                              aria-label={`${group.title}: subsections`}
                              class={toggleClass}
                            >
                              <svg
                                class="h-4 w-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.25"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d={chevron} />
                              </svg>
                            </button>
                          )}
                        </div>
                        {hasToggle && (
                          <OutlineCollapse id={`toc-sub-${group.id}`} enabled>
                            <ol class="mb-1 ml-3 space-y-0.5">
                              {group.children.map((child) => (
                                <li>
                                  <a
                                    href={`#${child.id}`}
                                    data-toc-link={child.id}
                                    class={childLink}
                                  >
                                    {child.number && (
                                      <span class="mr-1.5 font-bold tabular-nums">
                                        {child.number}
                                      </span>
                                    )}
                                    {child.title}
                                  </a>
                                </li>
                              ))}
                            </ol>
                          </OutlineCollapse>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </OutlineCollapse>
            )}
          </li>
        );
      })
    }
  </ol>

  <a
    href={REPORT_PDF_HREF}
    download
    data-track-report-download={isSidebar ? "reader-sidebar" : "reader-contents"}
    class={`mt-5 inline-flex min-h-[44px] items-center gap-2 rounded-sm text-[14px] font-bold text-grove transition-colors hover:text-grove-hover motion-reduce:transition-none ${focusRing}`}
  >
    <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
    Download PDF
  </a>
</nav>
