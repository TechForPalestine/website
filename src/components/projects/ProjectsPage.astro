---
import Layout from "../../layouts/Layout.astro";
import ProjectsNewComponent from "./ProjectsDirectoryPage.tsx";
import PageHeader from "../PageHeader.astro";
import "../../styles/base.css";
import type { ProjectMeta } from "../../utils/projectMeta";
import type { ProjectItem } from "../../types/projects";
import { projectPath } from "../../utils/projectSlug";
import {
  projectListSchema,
  projectSchema,
  projectSummary,
  toAbsoluteHttpUrl,
} from "../../utils/seo";

// Shared by /projects and /projects/<slug>. The slug route renders this same
// page with that project's preview tags; the island opens the matching dialog
// on its own by reading window.location.pathname (see ProjectsDirectoryPage.tsx), so no
// prop has to carry the matched project down to it.
interface Props {
  meta: ProjectMeta | null;
  /** Every project, server-fetched; empty when ProjectHub was unreachable. */
  projects?: ProjectItem[];
  /** The project a /projects/<slug> URL names, or null on /projects. */
  project?: ProjectItem | null;
}

const { meta, projects = [], project = null } = Astro.props;

// The directory and dialog are a client-only island, so without these the
// server HTML holds no project content at all. Crawlers that don't run JS
// (most AI crawlers) read the <noscript> copy below; everyone gets the schema.
const schema = project
  ? projectSchema(project)
  : projects.length > 0
    ? [projectListSchema(projects)]
    : [];
const projectWebsite = toAbsoluteHttpUrl(project?.websiteUrl);

const APPLY_URL = "https://techforpalestine.org/project-application-form";
---

<Layout
  title={meta?.title ?? "Incubator Projects - Tech for Palestine"}
  description={meta?.description ??
    "Explore the projects in the Tech for Palestine Incubator: technology built by pro-Palestine advocates for Palestinian freedom, from boycott apps to media tools."}
  image={meta?.image}
  imageAlt={meta?.imageAlt}
  twitterCard={meta?.twitterCard}
  schema={schema}
>
  <main>
    <PageHeader
      overline="Tech for Palestine"
      title="Incubator Projects"
      subtitle="What is the incubator?"
      subtitleLink="/incubator"
    >
      {
        /* The directory is ~90 projects long, so the apply action cannot live
          only at the foot of the page. It sits beside the title so it adds no
          height, and is a green pill, not a second dark block: DESIGN.md
          allows exactly one Nightfall block per page. */
      }
      <p class="text-[16px] leading-relaxed text-ink-secondary min-[810px]:max-w-[36ch]">
        Building something for Palestine? We help you build, grow and scale it.
      </p>
      <div class="flex w-full flex-col gap-3 min-[810px]:w-auto min-[810px]:flex-row">
        <a
          href="/membership"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-pill border-2 border-[#157A3E] bg-white px-6 py-3 text-[16px] font-bold text-[#157A3E] transition-colors duration-150 hover:bg-[#E7F2E9] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#157A3E] min-[810px]:w-auto"
        >
          Become a member
        </a>
        <a
          href={APPLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-pill bg-[#157A3E] px-6 py-3.5 text-[16px] font-bold text-white transition-colors duration-150 hover:bg-[#2F5C3F] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#157A3E] min-[810px]:w-auto"
        >
          Apply to the incubator
        </a>
      </div>
    </PageHeader>

    {/* Data is fetched client-side by the island, matching the /events pattern. */}
    <ProjectsNewComponent projects={[]} loading={true} client:only="react" />

    {
      projects.length > 0 && (
        <noscript>
          <div class="mx-auto max-w-[1200px] px-4 pb-12">
            {project && (
              <article class="mb-12 max-w-[65ch]">
                <h2 class="text-[28px] font-extrabold leading-tight text-ink">{project.name}</h2>
                {project.leadName && (
                  <p class="mt-2 text-[17px] text-ink-secondary">Led by {project.leadName}</p>
                )}
                {projectSummary(project) && (
                  <p class="mt-4 whitespace-pre-line text-[17px] leading-relaxed text-ink">
                    {projectSummary(project)}
                  </p>
                )}
                {projectWebsite && (
                  <p class="mt-4">
                    <a
                      href={projectWebsite}
                      rel="noopener noreferrer"
                      class="font-bold text-[#157A3E] underline"
                    >
                      Visit {project.name}
                    </a>
                  </p>
                )}
              </article>
            )}
            <h2 class="text-[22px] font-extrabold text-ink">All incubator projects</h2>
            <ul class="mt-4 space-y-3">
              {projects.map((item) => (
                <li>
                  <a href={projectPath(item)} class="font-bold text-[#157A3E] underline">
                    {item.name}
                  </a>
                  {item.elevatorPitch && (
                    <span class="text-ink-secondary">: {item.elevatorPitch}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </noscript>
      )
    }

    <div class="mx-auto max-w-[1200px] px-4 pb-16">
      <div
        class="flex flex-col items-start gap-5 rounded-md bg-[#101010] p-8 min-[810px]:flex-row min-[810px]:items-center min-[810px]:justify-between min-[810px]:p-10"
      >
        <p class="max-w-[40ch] text-[19px] font-bold leading-[1.4] text-white">
          Building something for Palestine? We'll help you grow it.
        </p>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a
            href="/membership"
            class="inline-flex min-h-[44px] items-center justify-center rounded-pill border-2 border-white px-5 py-3 text-[13px] font-bold text-white transition-colors duration-150 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Become a member
          </a>
          <a
            href={APPLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center justify-center rounded-pill bg-white px-5 py-3.5 text-[13px] font-bold text-[#101010] transition-colors duration-150 hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Apply to the incubator
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
