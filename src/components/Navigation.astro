---
import { Icon } from "astro-icon/components";
import NavBar from "./NavBar.svelte";
import { assignNavLabelVariant } from "../lib/navAssignment";
import { NAV_LABEL_EXPERIMENT, NAV_LABEL_HREF, NAV_LABELS } from "../utils/navLabelExperiment";

const currentRoute = Astro.url.pathname;

// "Get Involved" vs "Member Opportunities" label test. GrowthBook picks the variant on the
// server and it is rendered into the HTML, so there is no flicker. The id is a keyed hash of
// the day, IP and User-Agent (src/lib/navAssignment.ts): a visitor keeps one label all day
// and nothing is stored on their device. Without an assignment (flag off, CDN down, or
// NAV_ASSIGNMENT_SECRET unset) everyone sees "Get Involved" and nothing is tracked. Pages are served `private` (see
// src/middleware/cache-control.ts) so a shared cache never hands one visitor's label to others.
const assignedVariant = await assignNavLabelVariant(Astro.request, Astro.locals);
const navLabel = NAV_LABELS[assignedVariant ?? "A"];

type NavItem = {
  href: string;
  submenu: [string, string][] | null;
  experiment?: { name: string; variant: string };
};

const navigation: Map<string, NavItem> = new Map([
  [
    "Home",
    {
      href: "/",
      submenu: null,
    },
  ],
  [
    "About",
    {
      href: "/about",
      submenu: [
        ["Our Organization", "/about"],
        ["Team", "/team"],
        ["Media", "/media"],
        ["FAQ", "/faq"],
        ["Contact Us", "/contact"],
      ] as [string, string][],
    },
  ],
  [
    "Projects",
    {
      href: "/incubator",
      submenu: [
        ["View Projects", "/projects"],
        ["Start a project", "/incubator"],
        ["October Challenge", "/monthly-challenge"],
        ["Project Opportunities", "/ideas"],
        ["Tools", "/tools"],
      ] as [string, string][],
    },
  ],
  [
    navLabel,
    {
      href: NAV_LABEL_HREF,
      submenu: null,
      experiment: assignedVariant
        ? { name: NAV_LABEL_EXPERIMENT, variant: assignedVariant }
        : undefined,
    },
  ],
  [
    "Events",
    {
      href: "/events",
      submenu: [
        ["All Events", "/events"],
        ["Berlin Tech Rebellion", "https://techrebellion.techforpalestine.org/"],
      ] as [string, string][],
    },
  ],
  [
    "Updates",
    {
      href: "https://updates.techforpalestine.org",
      submenu: null,
    },
  ],
]);

// TODO: MOVE BANNER TO LAYOUT
---

<NavBar client:load navigation={navigation} currentRoute={currentRoute}>
  <Icon name="solar:hamburger-menu-outline" class="h-8 w-8" slot="burger-icon" />
  <Icon name="mdi:close" class="h-8 w-8" slot="close" />
</NavBar>

<script>
  import { trackNavLabel } from "../utils/navLabelExperiment";

  trackNavLabel();
</script>
