---
import { Icon } from "astro-icon/components";
import NavBar from "./NavBar.svelte";
import { evalServerFeature, loadFeaturePayload } from "../lib/growthbookServer";
import { getEnv } from "../utils/getEnv";
import {
  NAV_LABEL_EXPERIMENT,
  NAV_LABEL_HREF,
  NAV_LABELS,
  variantFromFeature,
} from "../utils/navLabelExperiment";

const currentRoute = Astro.url.pathname;

// "Get Involved" vs "Member Opportunities" label test. GrowthBook picks the variant on the
// server for a throwaway per-request id and it is rendered into the HTML, so there is no
// flicker and nothing is stored: a visitor can see a different label on each page view.
// Without an assignment (flag off, CDN down) everyone sees "Get Involved" and nothing is
// tracked. Pages are cacheable (default `public, max-age=600`); if a shared cache sits in
// front, one visitor's label is reused for that window, so check `cf-cache-status` is DYNAMIC.
const growthbookKey = getEnv("PUBLIC_GROWTHBOOK_CLIENT_KEY", Astro.locals);
const growthbookPayload = growthbookKey ? await loadFeaturePayload(growthbookKey) : undefined;
const assignedVariant = growthbookPayload
  ? variantFromFeature(
      evalServerFeature(growthbookPayload, NAV_LABEL_EXPERIMENT, crypto.randomUUID())
    )
  : null;
const navLabel = NAV_LABELS[assignedVariant ?? "A"];

type NavItem = {
  href: string;
  submenu: [string, string][] | null;
  experiment?: { name: string; variant: string };
};

const navigation: Map<string, NavItem> = new Map([
  [
    "Home",
    {
      href: "/",
      submenu: null,
    },
  ],
  [
    "About",
    {
      href: "/about",
      submenu: [
        ["Our Organization", "/about"],
        ["Team", "/team"],
        ["Media", "/media"],
        ["FAQ", "/faq"],
        ["Contact Us", "/contact"],
      ] as [string, string][],
    },
  ],
  [
    "Projects",
    {
      href: "/incubator",
      submenu: [
        ["View Projects", "/projects"],
        ["Start a project", "/incubator"],
        ["October Challenge", "/monthly-challenge"],
        ["Project Opportunities", "/ideas"],
        ["Tools", "/tools"],
      ] as [string, string][],
    },
  ],
  [
    navLabel,
    {
      href: NAV_LABEL_HREF,
      submenu: null,
      experiment: assignedVariant
        ? { name: NAV_LABEL_EXPERIMENT, variant: assignedVariant }
        : undefined,
    },
  ],
  [
    "Events",
    {
      href: "/events",
      submenu: [
        ["All Events", "/events"],
        ["Berlin Tech Rebellion", "https://techrebellion.techforpalestine.org/"],
      ] as [string, string][],
    },
  ],
  [
    "Updates",
    {
      href: "https://updates.techforpalestine.org",
      submenu: null,
    },
  ],
]);

// TODO: MOVE BANNER TO LAYOUT
---

<NavBar client:load navigation={navigation} currentRoute={currentRoute}>
  <Icon name="solar:hamburger-menu-outline" class="h-8 w-8" slot="burger-icon" />
  <Icon name="mdi:close" class="h-8 w-8" slot="close" />
</NavBar>

<script>
  import { trackNavLabel } from "../utils/navLabelExperiment";

  trackNavLabel();
</script>
