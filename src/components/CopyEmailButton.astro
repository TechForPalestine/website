---
// Icon-only copy button that sits right beside a displayed email address, for visitors whose mailto
// link opens nothing (no mail client set up, webmail users, locked-down work
// machines). It copies the text of the element whose id is `target`, so it
// works with addresses assembled by script (the obfuscated one on /contact)
// as well as static ones.
//
// Progressive enhancement: the button renders hidden (display:none) and the
// script reveals it by setting data-ready, so no dead button appears without
// JS. If the Clipboard API is unavailable or refused, it selects the address instead and tells the
// visitor to press Ctrl+C / Cmd+C.
import { Icon } from "astro-icon/components";
import { focusRing, focusRingOnDark } from "../utils/designClasses";

interface Props {
  /** id of the element whose text is the email address. */
  target: string;
  /** Use on the Nightfall terminal CTA. */
  onDark?: boolean;
}

const { target, onDark = false } = Astro.props;

const IDLE_LABEL = "Copy email address";

// Icon-only and borderless so it reads as part of the address, not a second
// action. 32px square keeps a comfortable hit area (WCAG 2.2 asks for 24px)
// without pushing the address away; -my-1 stops it inflating the line.
const base =
  "group -my-1 hidden h-8 w-8 shrink-0 items-center justify-center rounded-sm transition-colors motion-reduce:transition-none data-[ready]:inline-flex data-[state=copied]:text-grove";
const variant = onDark
  ? `text-white/60 hover:text-white data-[state=copied]:text-white ${focusRingOnDark}`
  : `text-ink-secondary hover:text-grove ${focusRing}`;
---

<button
  type="button"
  data-copy-email={target}
  data-state="idle"
  aria-label={IDLE_LABEL}
  title={IDLE_LABEL}
  class={`${base} ${variant}`}
>
  <Icon
    name="mdi:content-copy"
    class="h-4 w-4 group-data-[state=copied]:hidden"
    aria-hidden="true"
  />
  <Icon
    name="mdi:check"
    class="hidden h-4 w-4 group-data-[state=copied]:block"
    aria-hidden="true"
  />
  <span role="status" aria-live="polite" class="sr-only" data-copy-status></span>
</button>

<script>
  const RESET_MS = 2500;

  function selectText(el: Element): void {
    const range = document.createRange();
    range.selectNodeContents(el);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  const IDLE_LABEL = "Copy email address";

  // No visible text: the tooltip (title) carries the hint for pointer users
  // and the live region announces the outcome to screen readers.
  function announce(button: HTMLButtonElement, hint: string, status: string): void {
    button.title = hint;
    const statusEl = button.querySelector("[data-copy-status]");
    if (statusEl) statusEl.textContent = status;
  }

  function reset(button: HTMLButtonElement): void {
    button.dataset.state = "idle";
    announce(button, IDLE_LABEL, "");
  }

  async function copy(button: HTMLButtonElement): Promise<void> {
    const source = document.getElementById(button.dataset.copyEmail ?? "");
    const email = source?.textContent?.trim();
    if (!source || !email) return;

    try {
      await navigator.clipboard.writeText(email);
      button.dataset.state = "copied";
      announce(button, "Copied", `Copied ${email} to your clipboard`);
    } catch {
      // Clipboard API missing (non-secure context, old browser) or refused:
      // select the address so a keyboard copy works.
      selectText(source);
      const key = /Mac|iPhone|iPad/.test(navigator.userAgent) ? "Cmd+C" : "Ctrl+C";
      announce(button, `Press ${key}`, `Address selected. Press ${key} to copy it.`);
    }
    window.setTimeout(() => reset(button), RESET_MS);
  }

  document.querySelectorAll<HTMLButtonElement>("button[data-copy-email]").forEach((button) => {
    button.dataset.ready = "";
    button.addEventListener("click", () => void copy(button));
  });
</script>
