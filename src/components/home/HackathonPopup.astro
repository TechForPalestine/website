---
import ChallengeQuestion from "../ChallengeQuestion.astro";
import { CHALLENGE_URL, SITE_URL, isCampaignLive } from "../../utils/hackathonPopup";

// Homepage promo for the October 2026 Incubator challenge and its Oct 31
// hackathon, styled after the hackathon site's hero. Spec: docs/superpowers/specs/2026-10-04-hackathon-popup-design.md
// Renders nothing once the event is over; delete it and
// public/images/hackathon-2026/ after that.
const live = isCampaignLive(Date.now());
const IMG = "/images/hackathon-2026";
---

{
  live && (
    <dialog id="hackathon-popup" class="hk" aria-labelledby="hk-title">
      <div class="hk-card">
        <button
          type="button"
          class="hk-close"
          data-hk-close
          aria-label="Close challenge announcement"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>

        <div class="hk-copy">
          <p class="hk-label">
            <strong>October 2026 Challenge:</strong>
          </p>
          <h2 id="hk-title" class="hk-title">
            <ChallengeQuestion />
          </h2>
        </div>

        <div class="hk-cta">
          <a class="hk-btn" href={CHALLENGE_URL} data-hk-cta="challenge">
            <span>Learn more about the challenge and apply to the Incubator</span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a
            class="hk-btn hk-btn--outline"
            href={SITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-hk-cta="hackathon"
          >
            <span>Join our in-person hackathon on October 31st in Barcelona, Spain</span>
            <span class="sr-only"> (opens in a new tab)</span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7" />
              <path d="M8 7h9v9" />
            </svg>
          </a>
        </div>

        <div class="hk-stage">
          <img
            class="hk-img"
            data-hk-photo
            src={`${IMG}/hackathon-hero.webp`}
            srcset={`${IMG}/hackathon-hero-small.webp 640w, ${IMG}/hackathon-hero.webp 1077w`}
            sizes="(min-width: 768px) 440px, 100vw"
            width="1077"
            height="791"
            loading="lazy"
            decoding="async"
            alt="Hackathon participants laughing and debating ideas around a long workshop table"
          />
        </div>

        <dl class="hk-bar">
          <div>
            <dt class="hk-term">When</dt>
            <dd class="hk-value">
              Saturday
              <br />
              October 31st
            </dd>
            <dd class="hk-sub">9:00 - 18:00</dd>
          </div>
          <div>
            <dt class="hk-term">Where</dt>
            <dd class="hk-value">
              Canodrom
              <>
                <br />
                <span class="hk-nowrap">Barcelona, Spain</span>
              </>
            </dd>
          </div>
          <div class="hk-slash" aria-hidden="true">
            //
          </div>
          <div class="hk-partner">
            <dt class="hk-term">In partnership with</dt>
            <dd class="hk-value">Thaura.ai</dd>
          </div>
        </dl>
      </div>
    </dialog>
  )
}

<style>
  .hk {
    --hk-red: #d92d27;
    --hk-green: #157a3e;
    --hk-ink: #141414;
    width: min(920px, calc(100% - 48px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--hk-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .hk::backdrop {
    background: rgb(20 20 20 / 0.55);
  }
  :global(html:has(#hackathon-popup[open])) {
    overflow: hidden;
  }

  .hk-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas:
      "copy stage"
      "cta stage"
      "bar bar";
    column-gap: 40px;
    padding: 56px 48px 48px;
    background: #fff;
    font-family: Outfit, system-ui, sans-serif;
    line-height: 1.65;
  }
  .hk[open] .hk-card {
    animation: hk-rise 280ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  @keyframes hk-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .hk-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #fff;
    color: var(--hk-ink);
  }
  .hk-close:hover {
    background: #f2f2f2;
  }

  .hk-copy {
    grid-area: copy;
    align-self: end;
  }
  .hk-label {
    display: inline-flex;
    gap: 0.3em;
    background: var(--hk-red);
    color: #fff;
    font-size: 1.125rem;
    padding: 0.4rem 0.75rem;
    line-height: 1.4;
  }
  .hk-label strong {
    font-weight: 700;
  }
  .hk-title {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 2.8vw, 2.375rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hk-cta {
    grid-area: cta;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9rem 1.4rem;
    border: 2px solid var(--hk-ink);
    background: var(--hk-ink);
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .hk-btn svg {
    flex-shrink: 0;
  }
  .hk-btn:hover {
    background: #3a3a3a;
  }
  .hk-btn--outline {
    background: #fff;
    color: var(--hk-ink);
  }
  .hk-btn--outline:hover {
    background: var(--hk-ink);
    color: #fff;
  }
  .hk-btn:focus-visible,
  .hk-close:focus-visible {
    outline: 2px solid var(--hk-green);
    outline-offset: 3px;
  }

  .hk-stage {
    grid-area: stage;
    align-self: center;
    position: relative;
  }
  .hk-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hk-card--no-photo {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "copy" "cta" "bar";
  }
  .hk-card--no-photo .hk-stage {
    display: none;
  }

  .hk-bar {
    grid-area: bar;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 24px;
    margin-top: 40px;
    padding: 32px 36px;
    color: #fff;
  }
  .hk-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hk-green);
    clip-path: polygon(0 0, 96% 0, 96% 60%, 100% 60%, 100% 100%, 0 100%);
  }
  .hk-term {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hk-value {
    margin-top: 0.25rem;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .hk-sub {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
  }
  .hk-nowrap {
    white-space: nowrap;
  }
  .hk-slash {
    align-self: center;
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
  }
  .hk-partner {
    position: relative;
    padding-left: 3.75rem;
    margin-right: 1.5rem;
  }
  /* The Thaura camel mark: a pseudo-element, since a <dl> group may only hold <dt>/<dd>. */
  .hk-partner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 2.75rem;
    height: 3.5rem;
    background: url("/images/hackathon-2026/thaura-logo.svg") center / contain no-repeat;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 767px) {
    .hk {
      width: 100%;
      max-height: 85dvh;
      margin: auto 0 0;
    }
    /* A flex column rather than the desktop grid: position: sticky is limited
       to its containing block, and a grid item's is its own grid area, so the
       buttons could never stick. Here the card is the containing block. */
    .hk-card {
      display: flex;
      flex-direction: column;
      padding: 0;
    }
    /* The photo is dropped on phones: at full width it alone is ~250px tall,
       which made the sheet fill the screen. */
    .hk-stage {
      display: none;
    }
    .hk-copy {
      order: 2;
      align-self: stretch;
      padding: 56px 20px 0;
    }
    .hk-bar {
      order: 3;
    }
    .hk-cta {
      order: 4;
      align-self: stretch;
    }
    .hk-label {
      font-size: 1rem;
      padding: 0.25rem 0.6rem;
    }
    .hk-title {
      margin-top: 0.75rem;
      font-size: 1.375rem;
    }
    .hk-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin: 16px 20px 0;
      padding: 14px 16px;
    }
    .hk-term {
      font-size: 0.6875rem;
    }
    .hk-bar::before {
      clip-path: polygon(0 0, 92% 0, 92% 40%, 100% 40%, 100% 100%, 0 100%);
    }
    .hk-value {
      font-size: 1rem;
    }
    .hk-sub {
      font-size: 0.8125rem;
    }
    .hk-slash {
      display: none;
    }
    .hk-partner {
      grid-column: 1 / -1;
      min-height: 2.25rem;
      padding-left: 2.5rem;
      margin-right: 0;
    }
    .hk-partner::before {
      width: 1.75rem;
      height: 2.25rem;
    }
    .hk-cta {
      position: sticky;
      bottom: 0;
      z-index: 2;
      margin: 0;
      padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
      background: #fff;
    }
    .hk-cta {
      gap: 0.5rem;
    }
    .hk-btn {
      padding: 0.65rem 1rem;
      font-size: 0.9375rem;
    }
    /* Sticky rather than absolute so the close button stays reachable while the
       sheet scrolls. The negative bottom margin cancels its 44px + 12px in the
       flow, so it overlays the photo instead of pushing content down. */
    .hk-close {
      position: sticky;
      top: 12px;
      align-self: flex-end;
      margin: 12px 12px -56px 0;
    }
  }

  @media (max-width: 359px) {
    .hk-nowrap {
      white-space: normal;
    }
  }

  /* Tablets / small laptops: the two-column card is only ~620px wide here, too
     narrow for the four-across info bar, so tighten the card and wrap the bar. */
  @media (min-width: 768px) and (max-width: 959px) {
    .hk-card {
      column-gap: 24px;
      padding: 56px 28px 32px;
    }
    .hk-title {
      font-size: 1.625rem;
    }
    .hk-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 24px;
      margin-top: 32px;
      padding: 28px;
    }
    .hk-slash {
      display: none;
    }
    .hk-partner {
      grid-column: 1 / -1;
      margin-right: 0;
    }
  }

  /* Short viewports: the photo would make the dialog fill the screen height,
     so drop it and keep the card sized to its text. */
  @media (max-height: 700px) {
    .hk-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "copy" "cta" "bar";
    }
    .hk-stage {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hk[open] .hk-card {
      animation: none;
    }
  }
</style>

<script>
  import {
    SHOW_DELAY_MS,
    SHOWN_ATTRIBUTE,
    SHOWN_EVENT,
    readPopupState,
    shouldShowPopup,
    writePopupState,
    type DismissReason,
    type PopupCta,
  } from "../../utils/hackathonPopup";
  import { safeLocalStorage } from "../../utils/newsletterPopup";

  const dialog = document.getElementById("hackathon-popup");
  if (dialog instanceof HTMLDialogElement && typeof dialog.showModal === "function") {
    if (shouldShowPopup(readPopupState(safeLocalStorage()), Date.now())) schedule(dialog);
  }

  function schedule(dialog: HTMLDialogElement) {
    const card = dialog.querySelector<HTMLElement>(".hk-card");
    const photo = dialog.querySelector<HTMLImageElement>("[data-hk-photo]");

    const dropPhoto = () => card?.classList.add("hk-card--no-photo");
    if (photo) {
      photo.addEventListener("error", dropPhoto, { once: true });
      // Lazy images inside a closed <dialog> wait until it opens; start the
      // download now so the photo is there when the modal appears.
      photo.loading = "eager";
      if (photo.complete && photo.naturalWidth === 0) dropPhoto();
    }

    let reason: DismissReason = "escape";
    const closeWith = (next: DismissReason) => {
      reason = next;
      dialog.close();
    };

    dialog.querySelector("[data-hk-close]")?.addEventListener("click", () => closeWith("close"));
    dialog.querySelectorAll<HTMLAnchorElement>("[data-hk-cta]").forEach((link) => {
      link.addEventListener("click", () => {
        const cta = link.dataset.hkCta as PopupCta;
        window.plausible("Hackathon Popup CTA Click", { props: { cta } });
        closeWith(cta);
      });
    });
    // A click whose target is the <dialog> itself landed on the backdrop: the
    // card fills the dialog box, which has no padding.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeWith("backdrop");
    });
    // Fires for every close path, Esc included (which skips closeWith).
    dialog.addEventListener(
      "close",
      () => {
        writePopupState(safeLocalStorage(), { dismissedAt: Date.now() });
        window.plausible("Hackathon Popup Dismissed", { props: { reason } });
      },
      { once: true }
    );

    window.setTimeout(() => {
      if (!dialog.isConnected || dialog.open) return;
      dialog.showModal();
      document.documentElement.setAttribute(SHOWN_ATTRIBUTE, "");
      window.dispatchEvent(new Event(SHOWN_EVENT));
      window.plausible("Hackathon Popup Shown");
    }, SHOW_DELAY_MS);
  }
</script>
