---
/**
 * Homepage launch banner for membership: a flat Grove Green band with the
 * announcement and two calls to action.
 *
 * Remove this component (and its import in src/pages/index.astro) once the
 * launch period ends.
 */

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const pill = `inline-flex min-h-[44px] items-center justify-center rounded-pill px-7 py-3.5 text-[15px] font-bold transition-colors duration-150 ${focusRing}`;
---

<section aria-labelledby="membership-launch-heading" class="bg-grove text-white">
  <div
    class="mx-auto flex max-w-[1400px] flex-col gap-6 px-6 py-8 md:flex-row md:items-center md:justify-between md:gap-12 md:px-8 lg:px-16 2xl:px-28"
  >
    <div>
      <h2
        id="membership-launch-heading"
        class="text-[clamp(26px,3vw,34px)] font-extrabold leading-[1.1] tracking-[-0.015em]"
      >
        Membership is open.
      </h2>
      <p class="mt-2 max-w-[58ch] text-[17px] leading-[1.6] text-white/85">
        Pay what you can. Bring your skills to advocacy projects, join member events, and keep T4P
        funded by the people who believe in it.
      </p>
    </div>

    <div class="flex flex-shrink-0 flex-wrap gap-3">
      <a href="/membership" class={`${pill} bg-white text-grove-deep hover:bg-first-light`}>
        Become a member
      </a>
      <a
        href="/membership#inside"
        class={`${pill} border border-white/60 text-white hover:border-white hover:bg-white hover:text-grove-deep`}
      >
        What members do
      </a>
    </div>
  </div>
</section>
