---
/**
 * Homepage launch banner for membership: a slim Grove Green strip that slides
 * down from beneath the sticky navbar and overlays the top of the hero, so the
 * hero keeps its position. It must be rendered inside a `relative` container
 * (index.astro's <main>) and scrolls away with the page.
 *
 * Remove this component (and its import in src/pages/index.astro) once the
 * launch period ends.
 */

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const pill = `inline-flex min-h-[40px] items-center justify-center rounded-pill px-5 text-[14px] font-bold transition-colors duration-150 ${focusRing}`;
---

<!-- The wrapper clips the strip so it emerges from the navbar's bottom edge. -->
<div class="absolute inset-x-0 top-0 z-20 overflow-hidden">
  <section aria-labelledby="membership-launch-heading" class="launch-strip bg-grove text-white">
    <div
      class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-2.5 md:px-8 lg:px-16 2xl:px-28"
    >
      <p id="membership-launch-heading" class="text-[15px] font-bold leading-snug">
        <span aria-hidden="true">🎉</span>
        This week we're launching a new way to work with us:
        <span
          class="font-extrabold underline decoration-[#e4312b] decoration-[4px] underline-offset-[5px] [text-decoration-skip-ink:none]"
          >membership</span
        >!
      </p>

      <div class="flex flex-shrink-0 gap-2">
        <a href="/membership" class={`${pill} bg-white text-grove-deep hover:bg-first-light`}>
          Become a member
        </a>
        <a
          href="/membership#inside"
          class={`${pill} border border-white/60 text-white hover:border-white hover:bg-white hover:text-grove-deep`}
        >
          What members do
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .launch-strip {
      animation: strip-slide 600ms cubic-bezier(0.16, 1, 0.3, 1) 400ms backwards;
    }
  }

  @keyframes strip-slide {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
