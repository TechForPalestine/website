---
import { getTestimonials } from "../data/testimonials";

/**
 * Legacy-design-system twin of `home/TestimonialsSection.astro`.
 *
 * The design-system version depends on `design-system.css` (Fraunces/Outfit and
 * the `ts-*` typography scale), which `Layout.astro` deliberately does not load.
 * Rather than pull that stylesheet into every legacy page, this renders the same
 * shared testimonial data in the legacy grey/green idiom.
 */
interface Props {
  membershipLive?: boolean;
  heading?: string;
  subheading?: string;
  background?: "default" | "green";
}

const {
  membershipLive = false,
  heading = "What it's like to work with T4P",
  subheading = "Project leaders, mentors, and members on their time inside the coalition.",
  background = "default",
} = Astro.props;

const testimonials = getTestimonials(membershipLive);
const sectionBgClass = background === "green" ? "border-green-100 bg-green-50" : "border-zinc-200 bg-zinc-50";
---

<section class:list={["border-t py-16", sectionBgClass]}>
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <h2 class="text-3xl font-extrabold tracking-tight text-zinc-900">{heading}</h2>
    <p class="mt-3 max-w-2xl text-lg text-zinc-600">{subheading}</p>

    <div class="legacy-marquee -mx-6 mt-12 overflow-hidden sm:-mx-8" aria-label="Testimonials carousel">
      <div class="legacy-marquee-track flex w-max gap-6 px-6 will-change-transform sm:px-8">
        {
        [...testimonials, ...testimonials, ...testimonials].map((t, i) => (
          <figure
            class:list={[
              "legacy-testimonial-card motion-safe:hover:-translate-y-1 flex min-w-[300px] max-w-[300px] shrink-0 flex-col rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm transition-[transform,box-shadow] duration-200 hover:border-zinc-300 hover:shadow-md sm:min-w-[400px] sm:max-w-[400px]",
              i >= testimonials.length && "legacy-marquee-dupe",
            ]}
          >
            <svg
              class="mb-5 shrink-0 text-[#168039]"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z" />
            </svg>
            <blockquote class="flex-1 text-base leading-relaxed text-zinc-800">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              {t.headshots ? (
                <div class="relative h-12 w-12 shrink-0">
                  <img
                    src={t.headshots[0]}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                    decoding="async"
                    class="absolute -left-2 top-0 z-10 h-8 w-8 rounded-full object-cover ring-1 ring-zinc-200"
                  />
                  <img
                    src={t.headshots[1]}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                    decoding="async"
                    class="absolute bottom-0 right-0 h-8 w-8 rounded-full object-cover ring-1 ring-zinc-200"
                  />
                </div>
              ) : (
                <img
                  src={t.headshot}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 rounded-full object-cover ring-1 ring-zinc-200"
                />
              )}
              <div>
                <p class="font-semibold text-zinc-900">{t.name}</p>
                <p class="text-sm text-zinc-600">{t.role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes legacy-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.333%);
    }
  }

  .legacy-marquee-track {
    animation: legacy-marquee-scroll 40s linear infinite;
  }

  .legacy-marquee:hover .legacy-marquee-track {
    animation-play-state: paused;
  }

  /* Without JS or with reduced motion, fall back to a static wrapped grid. */
  :global(html.no-js) .legacy-marquee-dupe {
    display: none;
  }
  :global(html.no-js) .legacy-marquee {
    overflow: visible;
  }
  :global(html.no-js) .legacy-marquee-track {
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    animation: none;
  }
  :global(html.no-js) .legacy-testimonial-card {
    flex: 1 1 300px;
  }

  @media (prefers-reduced-motion: reduce) {
    .legacy-marquee-dupe {
      display: none;
    }
    .legacy-marquee {
      overflow: visible;
    }
    .legacy-marquee-track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      animation: none;
    }
    .legacy-testimonial-card {
      flex: 1 1 300px;
    }
  }
</style>
