---
import JoinFlow from "./JoinFlow";
import { getTestimonials } from "../../data/testimonials";

interface Props {
  membershipLive?: boolean;
  /** Renders with the design-system's ts-* typography scale, section-band
   * layout, and 1400px container — used on /membership-new, which loads
   * `design-system.css` via HomeLayout. The legacy /membership page (plain
   * `Layout.astro`, no design-system.css) keeps the default plain-Tailwind
   * rendering below instead. */
  designSystem?: boolean;
}

const { membershipLive = false, designSystem = false } = Astro.props;

const testimonials = getTestimonials(membershipLive);
const mohanad = testimonials.find((t) => t.name === "Mohanad");
const veda = testimonials.find((t) => t.name === "Veda");
const featuredTestimonials = [mohanad, veda].filter((t): t is NonNullable<typeof t> => Boolean(t));

const CALENDLY_URL = "https://calendly.com/d/ctpm-sw2-yvc/t4p-intro-call";

const accordionItems = [
  {
    question: "Connect with the community",
    answer: "Meet vetted Palestine supporters from around the world.",
    open: true,
  },
  {
    question: "Volunteer on projects",
    answer:
      "Apply your skills to projects for Palestine, like ethical tech alternatives, media campaigns and community organizing.",
    open: false,
  },
  {
    question: "Attend events",
    answer: "Regular team meetings, webinars, book clubs, summits and other gatherings.",
    open: false,
  },
  {
    question: "Vetted coalition",
    answer: "Every T4P member is vetted to create a secure community.",
    open: false,
  },
  {
    question: "Start something new",
    answer: "Propose and lead your own initiative to assist in Palestinian liberation.",
    open: false,
  },
  {
    question: "Insider updates",
    answer:
      "Get advanced updates about new projects, events, and what's happening in the organization.",
    open: false,
  },
];

// Class strings for the two rendering modes. `ts-*` classes (Fraunces/Outfit
// typography) and the alternating bg-page/bg-sand section-band convention
// require `design-system.css`, which only HomeLayout loads — the plain
// variant below uses arbitrary Tailwind values instead so it renders
// correctly under the legacy Layout too. Tailwind config tokens like
// `bg-page`, `bg-sand`, `border-butter`, `text-ink-secondary`, and
// `rounded-pill` are safe in both modes: they're generated by the Tailwind
// integration into `base.css`, which both layouts import.
const cx = designSystem
  ? {
      shellPad: "px-6 py-14 min-[810px]:px-10 min-[810px]:py-20",
      container: "mx-auto max-w-[1480px]",
      eyebrow: "ts-overline text-[#157A3E]",
      h1: "ts-editorial text-ink",
      lede: "ts-body-large text-ink",
      heroRadius: "rounded-[20px]",
      h2: "ts-heading text-ink",
      body: "ts-body text-ink-secondary",
      bandBg: "bg-positive-tint",
      bandBorder: "border-butter",
      navEyebrow: "ts-overline text-[#157A3E]",
      cardRadius: "rounded-[20px]",
      cardBorder: "border border-butter",
      cardBg: "bg-page",
      cardTitle: "ts-body-large font-semibold text-ink",
      cardLink: "ts-label text-[#157A3E]",
      barBg: "bg-sand",
      barBorder: "border-butter",
      barText: "ts-label text-ink",
      barLink: "ts-body-small text-ink-secondary",
      quote: "ts-quote text-ink",
      name: "ts-label text-ink",
      role: "ts-body-small text-ink-secondary",
      question: "ts-body-large font-medium text-ink",
      answer: "ts-body max-w-[65ch] text-ink-secondary",
      suggestedShell: "rounded-[16px] bg-sand",
      suggestedLabel: "ts-overline text-[#157A3E]",
      suggestedBody: "ts-body-large text-ink",
      dueCardShell: "rounded-[16px] border border-butter",
      dueCardTitle: "ts-body-large font-semibold text-ink",
      dueCardBody: "ts-body text-ink-secondary",
      dueCardLink: "ts-label text-[#157A3E]",
      ctaShell: "rounded-[20px] bg-ink-dark",
      ctaText: "ts-body-large font-semibold text-page",
      ctaButton: "ts-label rounded-pill bg-page text-ink-dark hover:bg-page/90",
    }
  : {
      shellPad: "px-6 py-16 min-[810px]:py-20",
      container: "mx-auto max-w-[1280px]",
      eyebrow: "text-xs font-bold uppercase tracking-[0.14em] text-[#157A3E]",
      h1: "text-[38px] font-extrabold leading-[1.05] text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]",
      lede: "text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]",
      heroRadius: "rounded-md",
      h2: "text-[28px] font-extrabold leading-tight text-ink min-[810px]:text-[38px]",
      body: "text-[17px] leading-relaxed text-ink-secondary",
      bandBg: "bg-[#E7F2E9]",
      bandBorder: "border-[#D2E4D6]",
      navEyebrow: "text-xs font-bold uppercase tracking-[0.14em] text-[#2F5C3F]",
      cardRadius: "rounded-lg",
      cardBorder: "border border-[#D2E4D6]",
      cardBg: "bg-white",
      cardTitle: "text-[17px] font-bold leading-snug text-ink",
      cardLink: "text-sm font-bold text-[#157A3E]",
      barBg: "bg-[#F2F3EE]",
      barBorder: "border-ink-divider",
      barText: "text-[17px] font-bold text-ink",
      barLink: "text-sm text-ink-secondary",
      quote: "text-[19px] leading-relaxed tracking-tight text-ink",
      name: "text-[13px] font-bold text-ink",
      role: "text-[13px] text-ink-secondary",
      question: "text-base font-bold text-ink",
      answer: "text-[16px] leading-relaxed text-ink-secondary",
      suggestedShell: "rounded-lg bg-[#F2F3EE]",
      suggestedLabel: "text-[11px] font-bold uppercase tracking-[0.12em] text-[#157A3E]",
      suggestedBody: "text-[18px] leading-relaxed text-ink",
      dueCardShell: "rounded-lg border border-ink-divider",
      dueCardTitle: "text-[17px] font-bold text-ink",
      dueCardBody: "text-[16px] leading-relaxed text-ink-secondary",
      dueCardLink: "text-[13px] font-bold text-[#157A3E]",
      ctaShell: "rounded-md bg-[#101010]",
      ctaText: "text-lg font-bold text-white",
      ctaButton: "text-sm font-bold rounded-full bg-white text-[#101010] hover:bg-white/90",
    };
---

<div class="membership-main">
  <section class={`${cx.shellPad} ${designSystem ? "bg-page" : ""}`}>
    <div class={`${cx.container} grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14`}>
      <div class="min-w-0">
        <div class={`mb-4 ${cx.eyebrow}`}>Tech for Palestine Membership</div>
        <h1 class={`mb-6 ${cx.h1}`}>Join the community building for Palestinian liberation.</h1>
        <p class={`mb-3.5 ${cx.lede}`}>
          Members contribute to <strong class="font-bold text-[#157A3E]">advocacy projects</strong
          >, receive invites to <strong class="font-bold text-[#157A3E]">member events</strong>, and
          sustain T4P with <strong class="font-bold text-[#157A3E]">grassroots fundings</strong>.
        </p>
        <img
          src="/images/membership/members-group.webp"
          alt="Tech for Palestine members gathered outside a venue at a community event"
          width="1600"
          height="1232"
          class={`mt-8 block h-auto w-full ${cx.heroRadius}`}
          fetchpriority="high"
        />
      </div>
      <div id="join" class="min-w-0 scroll-mt-24 lg:sticky lg:top-24 lg:self-start">
        <JoinFlow client:only="react" designSystem={designSystem} />
      </div>
    </div>
  </section>

  <section class={`border-y ${cx.bandBorder} ${cx.bandBg}`}>
    <div class={`${cx.container} px-6 py-8`}>
      <div class={`mb-5 ${cx.navEyebrow}`}>About T4P Membership</div>
      <div class="grid grid-cols-1 gap-5 min-[810px]:grid-cols-3">
        <a
          href="#inside"
          class={`flex flex-col gap-3.5 ${cx.cardRadius} ${cx.cardBorder} border-t-[3px] border-t-[#157A3E] ${cx.cardBg} p-6 text-ink transition-[border-color,box-shadow,transform] duration-150 hover:shadow-sm`}
        >
          <h3 class={cx.cardTitle}>What does it mean to be a T4P member?</h3>
          <span class={`mt-auto border-t border-[#E4EEE6] pt-3.5 ${cx.cardLink}`}>
            See what we do ↓
          </span>
        </a>
        <a
          href="#voices"
          class={`flex flex-col gap-3.5 ${cx.cardRadius} ${cx.cardBorder} border-t-[3px] border-t-[#157A3E] ${cx.cardBg} p-6 text-ink transition-[border-color,box-shadow,transform] duration-150 hover:shadow-sm`}
        >
          <h3 class={cx.cardTitle}>What do members say about T4P?</h3>
          <span class={`mt-auto border-t border-[#E4EEE6] pt-3.5 ${cx.cardLink}`}>
            Read their testimonials ↓
          </span>
        </a>
        <a
          href="#dues"
          class={`flex flex-col gap-3.5 ${cx.cardRadius} ${cx.cardBorder} border-t-[3px] border-t-[#157A3E] ${cx.cardBg} p-6 text-ink transition-[border-color,box-shadow,transform] duration-150 hover:shadow-sm`}
        >
          <h3 class={cx.cardTitle}>How do dues and time work?</h3>
          <span class={`mt-auto border-t border-[#E4EEE6] pt-3.5 ${cx.cardLink}`}>
            Get the details ↓
          </span>
        </a>
      </div>
    </div>
    <div class="flag-stripe" aria-hidden="true"></div>
  </section>

  <section id="inside" class={`${cx.shellPad} ${designSystem ? "bg-page" : ""}`}>
    <div
      class={`${cx.container} grid grid-cols-1 items-start gap-10 min-[810px]:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] min-[810px]:gap-14`}
    >
      <div class="min-w-0">
        <h2 class={`mb-5 ${cx.h2}`}>What being a member looks like</h2>
        <p class={cx.body}>
          This is a vetted coalition for anyone who wants to change the narrative on Palestine or
          ethics in the tech industry. There's a place for you, whether you're a thinker, builder,
          leader, developer, marketer or activist.
        </p>
        <img
          src="/images/membership/member-panel.webp"
          alt="A Tech for Palestine member speaking on a panel at a community event"
          width="1600"
          height="1068"
          class={`mt-7 block h-auto w-full ${cx.heroRadius}`}
        />
      </div>
      <div class="flex min-w-0 flex-col justify-start gap-4">
        {
          accordionItems.map((item) => (
            <details
              data-accordion
              class={`group overflow-hidden ${cx.cardRadius} ${cx.cardBorder} border-t-[3px] border-t-[#157A3E] ${cx.cardBg} shadow-sm`}
              open={item.open}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4">
                <span class={cx.question}>{item.question}</span>
                <span
                  aria-hidden="true"
                  class="shrink-0 text-lg font-bold text-[#157A3E] transition-transform group-open:rotate-180"
                >
                  +
                </span>
              </summary>
              <p data-accordion-content class={`px-5 pb-4 ${cx.answer}`}>
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class={designSystem ? "bg-page px-6" : "px-6"}>
    <div class={cx.container}>
      <div
        class={`flex flex-wrap items-center justify-between gap-6 ${cx.cardRadius} border ${cx.barBorder} ${cx.barBg} px-6 py-5`}
      >
        <span class={cx.barText}>Want to help us build?</span>
        <div class="flex flex-wrap items-center gap-5">
          <a
            href="#join"
            data-track-join-click="secondary_cta"
            class="rounded-pill bg-[#157A3E] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[#0e5a2f]"
          >
            Join now
          </a>
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={`${cx.barLink} underline underline-offset-[3px]`}
          >
            Still deciding? Chat with membership
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="voices" class={`mt-10 border-y ${cx.bandBorder} ${cx.bandBg}`}>
    <div class={`${cx.container} px-6 py-8`}>
      <h2 class={`mb-7 ${cx.h2}`}>Thoughts from membership</h2>
      <div class="grid grid-cols-1 gap-5 min-[810px]:grid-cols-2">
        {
          featuredTestimonials.map((t) => (
            <figure class={`${cx.cardRadius} ${cx.cardBorder} border-t-[3px] border-t-[#157A3E] ${cx.cardBg} p-7`}>
              <blockquote class={cx.quote}>“{t.quote}”</blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                <img
                  src={t.headshot}
                  alt=""
                  width="34"
                  height="34"
                  class="block h-[34px] w-[34px] rounded-full"
                />
                <span class="block leading-snug">
                  <strong class={`block ${cx.name}`}>{t.name}</strong>
                  <span class={cx.role}>{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
    <div class="flag-stripe" aria-hidden="true"></div>
  </section>

  <section id="dues" class={`${cx.shellPad} ${designSystem ? "bg-page" : ""}`}>
    <div class={`${cx.container} grid grid-cols-1 items-start gap-10 min-[810px]:grid-cols-2 min-[810px]:gap-14`}>
      <div class="min-w-0">
        <h2 class={`mb-5 ${cx.h2}`}>Dues, time, and waivers</h2>
        <p class={`mb-4 ${cx.body}`}>
          Our independence comes from our members. By paying dues based on what you can afford,
          you sustain our operations so we stay accountable to our community and not external
          funders.
        </p>
        <p class={`mt-5 font-bold text-[#157A3E] ${designSystem ? "ts-body" : "text-[17px] leading-relaxed"}`}>
          Dues sustain T4P projects:<br />
          Marketing &middot; Engineering &middot; Volunteers &middot; Mentorship for projects via
          T4P staff support, software access, partnerships and grants.
        </p>
        <div class={`mt-6 p-6 ${cx.suggestedShell}`}>
          <div class={`mb-3 ${cx.suggestedLabel}`}>Suggested amount</div>
          <p class={cx.suggestedBody}>
            Dues are pay-what-you-can. We suggest dues equal to one hour of income (or 1/2000th of
            your annual income), which can be calculated at checkout.
          </p>
        </div>
      </div>
      <div class="flex min-w-0 flex-col gap-4">
        <div class={`p-6 ${cx.dueCardShell}`}>
          <h3 class={`mb-2.5 ${cx.dueCardTitle}`}>I can't afford dues</h3>
          <p class={`mb-3.5 ${cx.dueCardBody}`}>
            T4P aims for inclusivity. Email us for a waiver if you are located in, or a refugee
            from Gaza or West Bank, or if personal circumstances make dues unaffordable.
          </p>
          <span class="relative inline-flex">
            <a
              href="mailto:membership@techforpalestine.org"
              data-copy-email="membership@techforpalestine.org"
              class={cx.dueCardLink}
            >
              Request a waiver →
            </a>
            <span
              role="status"
              data-copy-confirm
              hidden
              class="absolute left-0 top-full z-10 mt-2 whitespace-nowrap rounded-pill bg-ink px-3 py-1.5 text-xs text-white"
            >
              membership@techforpalestine.org copied to clipboard
            </span>
          </span>
        </div>
        <div class={`p-6 ${cx.dueCardShell}`}>
          <h3 class={`mb-2.5 ${cx.dueCardTitle}`}>I don't have time to contribute</h3>
          <p class={`mb-3.5 ${cx.dueCardBody}`}>
            You can become a Supporting Member if you would like to support T4P financially and
            receive updates.
          </p>
          <a
            href={designSystem ? "/supporting-member-new" : "/supporting-member"}
            class={cx.dueCardLink}
          >
            Become a Supporting Member →
          </a>
        </div>
        <div class={`p-6 ${cx.dueCardShell}`}>
          <h3 class={`mb-2.5 ${cx.dueCardTitle}`}>I still have questions</h3>
          <p class={`mb-3.5 ${cx.dueCardBody}`}>
            Book an intro call with membership or send us an email. We'd love to hear from you!
          </p>
          <div class="flex flex-wrap items-center gap-5">
            <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class={cx.dueCardLink}>
              Book an intro call →
            </a>
            <span class="relative inline-flex">
              <a
                href="mailto:membership@techforpalestine.org"
                data-copy-email="membership@techforpalestine.org"
                class={cx.dueCardLink}
              >
                Email us →
              </a>
              <span
                role="status"
                data-copy-confirm
                hidden
                class="absolute left-0 top-full z-10 mt-2 whitespace-nowrap rounded-pill bg-ink px-3 py-1.5 text-xs text-white"
              >
                membership@techforpalestine.org copied to clipboard
              </span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class={designSystem ? "bg-page px-6 pb-14 min-[810px]:pb-20" : "px-6 pb-16 min-[810px]:pb-20"}>
    <div class={cx.container}>
      <div class={`flex flex-wrap items-center justify-between gap-6 px-7 py-6 ${cx.ctaShell}`}>
        <span class={cx.ctaText}>We're working on projects for Palestine.</span>
        <a
          href="#join"
          data-track-join-click="bottom_cta"
          class={`px-7 py-3.5 transition-colors ${cx.ctaButton}`}
        >
          Join now
        </a>
      </div>
    </div>
  </section>

  <a
    href="#join"
    id="membership-floating-cta"
    data-track-join-click="floating_cta"
    hidden
    class={`fixed bottom-4 right-4 z-40 rounded-pill bg-[#157A3E] px-5 py-3 text-white shadow-lg opacity-0 translate-y-2 pointer-events-none transition-[opacity,transform] duration-200 hover:bg-[#0e5a2f] motion-reduce:translate-y-0 motion-reduce:transition-opacity sm:bottom-6 sm:right-6 ${designSystem ? "ts-label" : "text-sm font-bold"}`}
  >
    Become a member
  </a>
</div>

<style>
  @keyframes flagFlow {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: -200% 50%;
    }
  }

  .flag-stripe {
    height: 4px;
    margin: 0 0 10px;
    background: linear-gradient(
        to right,
        #101010,
        #ffffff,
        #157a3e,
        #ce1126,
        #101010,
        #ffffff,
        #157a3e,
        #ce1126,
        #101010
      )
      0% 0% / 200% 100%;
    animation: flagFlow 14s linear infinite;
    box-shadow: 0 0 0 1px rgba(16, 16, 16, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .flag-stripe {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-track-join-click]").forEach((anchor) => {
    anchor.addEventListener("click", () => {
      const location = anchor.getAttribute("data-track-join-click") ?? "unknown";
      if (typeof window.plausible !== "undefined") {
        window.plausible("Membership Join Click", {
          props: { cta_location: location, destination: "#join" },
        });
      }
    });
  });

  const COPY_CONFIRM_MS = 1500;

  // mailto: links silently do nothing when the browser has no default mail
  // client registered — copying the address is a fallback that always gives
  // the visitor something, without blocking the native mailto navigation for
  // visitors who do have one.
  document.querySelectorAll<HTMLAnchorElement>("[data-copy-email]").forEach((anchor) => {
    const confirm = anchor.parentElement?.querySelector<HTMLElement>("[data-copy-confirm]");
    anchor.addEventListener("click", () => {
      const email = anchor.getAttribute("data-copy-email");
      if (!email || !confirm) return;
      navigator.clipboard
        .writeText(email)
        .then(() => {
          confirm.hidden = false;
          window.setTimeout(() => {
            confirm.hidden = true;
          }, COPY_CONFIRM_MS);
        })
        .catch(() => {});
    });
  });

  // The join card is only sticky within the hero section's own row (see
  // `#join`'s `lg:sticky lg:top-24`) — once that section scrolls past, there's
  // no persistent way back to the form until the next inline "Join now" CTA.
  // This floating button fills that gap without opening a second form: it
  // just scrolls back up to the real one.
  const floatingCta = document.getElementById("membership-floating-cta");
  const heroJoinCard = document.getElementById("join");
  const FLOATING_CTA_TRANSITION_MS = 200;
  let floatingCtaHideTimeout: number | undefined;

  if (floatingCta && heroJoinCard) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        window.clearTimeout(floatingCtaHideTimeout);
        if (entry.isIntersecting) {
          floatingCta.classList.add("opacity-0", "translate-y-2", "pointer-events-none");
          floatingCta.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
          floatingCtaHideTimeout = window.setTimeout(() => {
            floatingCta.hidden = true;
          }, FLOATING_CTA_TRANSITION_MS);
        } else {
          floatingCta.hidden = false;
          // Two rAFs, not one: removing `hidden` and toggling the opacity
          // classes in the same frame skips the transition entirely — the
          // browser needs a style flush in between to register the "before"
          // state before the "after" state kicks off the animation.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              floatingCta.classList.remove("opacity-0", "translate-y-2", "pointer-events-none");
              floatingCta.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            });
          });
        }
      },
      { threshold: 0 },
    );
    observer.observe(heroJoinCard);
  }

  // Native <details> snaps open/closed instantly. Animate it by intercepting
  // the summary click, driving the answer's height with the Web Animations
  // API, and only flipping `open` ourselves once the animation settles —
  // `open` still reflects real state throughout for assistive tech and the
  // group-open: icon rotation, it's just delayed to match what's on screen.
  const ACCORDION_ANIMATION_MS = 250;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLDetailsElement>("[data-accordion]").forEach((details) => {
    const summary = details.querySelector("summary");
    const content = details.querySelector<HTMLElement>("[data-accordion-content]");
    if (!summary || !content) return;

    let animation: Animation | undefined;

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (prefersReducedMotion) {
        details.open = !details.open;
        return;
      }

      animation?.cancel();
      content.style.overflow = "hidden";

      if (details.open) {
        const startHeight = content.scrollHeight;
        animation = content.animate([{ height: `${startHeight}px` }, { height: "0px" }], {
          duration: ACCORDION_ANIMATION_MS,
          easing: "ease",
        });
        animation.onfinish = () => {
          details.open = false;
          content.style.overflow = "";
          content.style.height = "";
        };
      } else {
        details.open = true;
        const targetHeight = content.scrollHeight;
        animation = content.animate([{ height: "0px" }, { height: `${targetHeight}px` }], {
          duration: ACCORDION_ANIMATION_MS,
          easing: "ease",
        });
        animation.onfinish = () => {
          content.style.overflow = "";
          content.style.height = "";
        };
      }
    });
  });
</script>
