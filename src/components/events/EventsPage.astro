---
import Layout from "../../layouts/Layout.astro";
import EventsComponent from "./EventsRoot.tsx";
import "../../styles/base.css";
import type { EventMeta } from "../../utils/eventMeta";
import type { EventItem } from "../../types/events";

interface Props {
  meta: EventMeta | null;
  // Fetched by the route during SSR so the list (and the spotlight image, the
  // LCP element) is in the initial HTML. null means the server fetch failed;
  // the island then falls back to fetching /api/events itself.
  events: EventItem[] | null;
}

const { meta, events } = Astro.props;
---

<Layout
  title={meta?.title ?? "Events - Tech for Palestine"}
  description={meta?.description ??
    "Tech for Palestine events: community calls, webinars, workshops and gatherings where builders, organizers and allies act for Palestinian liberation."}
  image={meta?.image}
>
  <div class="mx-auto max-w-6xl px-4 pt-10">
    <header class="grid gap-[18px] border-b border-gray-200 pb-10">
      <div class="text-xs font-semibold uppercase tracking-[0.14em] text-[#EA4335]">
        Tech for Palestine
      </div>
      <h1
        class="max-w-[14ch] text-[44px] font-bold leading-[0.98] tracking-[-0.03em] text-gray-900 sm:text-[64px] lg:text-[76px]"
      >
        Events
      </h1>
      <p class="max-w-[46ch] text-[17px] leading-[1.55] text-gray-600">
        Tech for Palestine events bring together builders, organizers, and allies to collaborate,
        share ideas, and take action.
      </p>
    </header>
  </div>

  <EventsComponent events={events ?? []} loading={events === null} client:load />
</Layout>
