---
// Homepage strip announcing the next Community Call: shown only while a call
// is live or starts within 7 days. Rendered by index.astro directly below the
// navigation (Layout.astro renders <Navigation /> above the slot).
import * as Sentry from "@sentry/astro";
import { fetchCommunityCalls, type CommunityCall } from "../store/notionClient";
import { featuredCall, callState } from "../utils/communityCall";
import { reportError } from "../lib/report-error";
import { formatShortCallTime } from "../utils/formatCallTime";

const ctx = Astro.locals.runtime?.ctx;

let calls: CommunityCall[] = [];
try {
  calls = await Promise.race([
    fetchCommunityCalls(Astro.locals),
    new Promise<CommunityCall[]>((_, reject) =>
      setTimeout(() => reject(new Error("community call banner fetch timed out")), 1200)
    ),
  ]);
} catch (error) {
  reportError(error, { context: "CommunityCallBanner: fetchCommunityCalls" });
  ctx?.waitUntil(Promise.resolve(Sentry.flush(2000)));
}

const now = new Date();
const call = featuredCall(calls, now);
const state = call ? callState(call, now) : null;

// The banner only ever flags something time-sensitive — never renders for
// "none scheduled" or "ended", and only for "upcoming" within 7 days.
const BANNER_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;
const shouldShow =
  call &&
  (state === "live" ||
    (state === "upcoming" &&
      new Date(call.startUtcIso).getTime() - now.getTime() < BANNER_WINDOW_MS));

const localTime = call ? formatShortCallTime(call.startUtcIso, now) : "";
---

{
  shouldShow && call && (
    <a
      href="/community-call"
      class="cc-banner group block bg-grove text-white focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-white"
      data-start-iso={call.startUtcIso}
      data-state={state}
    >
      <span class="mx-auto flex max-w-[1400px] items-center gap-x-4 px-6 py-2.5 md:px-8 lg:px-16 2xl:px-28">
        <span class="flex min-w-0 flex-col sm:flex-row sm:items-center sm:gap-x-4">
          <span class="flex flex-shrink-0 items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-first-light">
            <span
              class="cc-live-dot hidden h-2 w-2 rounded-full bg-white motion-safe:animate-pulse"
              aria-hidden="true"
            />
            <span data-cc-banner-state="upcoming">Community call</span>
            <span data-cc-banner-state="live">Live now</span>
          </span>
          <span class="cc-title hidden min-w-0 truncate text-[15px] font-bold sm:block">
            {call.title}
          </span>
          <span
            class="invisible whitespace-nowrap text-[15px] font-bold sm:font-normal sm:text-first-light"
            data-cc-banner-state="upcoming"
            data-cc-banner-time
          >
            {localTime}
          </span>
        </span>
        <span class="ml-auto inline-flex min-h-[32px] flex-shrink-0 items-center whitespace-nowrap rounded-pill bg-white px-4 text-[13px] font-bold text-grove-deep transition-colors group-hover:bg-first-light motion-reduce:transition-none">
          <span data-cc-banner-cta="join">Join the call</span>
          <span data-cc-banner-cta="far">Add to calendar</span>
        </span>
      </span>
    </a>
  )
}

<!-- Without JS the server-rendered time (UTC) is the best available. -->
<noscript>
  <style is:inline>
    [data-cc-banner-time] {
      visibility: visible;
    }
  </style>
</noscript>

<script>
  import { formatShortCallTime } from "../utils/formatCallTime";

  const LIVE_WINDOW_MS = 2 * 60 * 60 * 1000;
  const DAY_MS = 24 * 60 * 60 * 1000;

  const banner = document.querySelector<HTMLElement>(".cc-banner");
  const startIso = banner?.dataset.startIso;
  if (banner && startIso) {
    const start = new Date(startIso).getTime();
    const now = Date.now();

    let state: "upcoming" | "live" | "ended" = "upcoming";
    if (now >= start && now < start + LIVE_WINDOW_MS) state = "live";
    else if (now >= start + LIVE_WINDOW_MS) state = "ended";
    banner.dataset.state = state;

    // Ended (or the cached featured call went stale): the banner has nothing
    // time-sensitive left to say, so hide it rather than show "ended" content.
    if (state === "ended") banner.hidden = true;

    // "Join the call" when live or under a day out; otherwise the far CTA.
    banner.dataset.cta = state === "live" || start - now < DAY_MS ? "join" : "far";

    // The server renders the time (and "Today"/"Tomorrow") in the edge
    // runtime's zone, which is UTC, not the visitor's. Replace it.
    const timeEl = banner.querySelector<HTMLElement>("[data-cc-banner-time]");
    if (timeEl) {
      timeEl.textContent = formatShortCallTime(startIso, new Date());
      timeEl.classList.remove("invisible");
    }
  }
</script>

<style>
  .cc-banner[hidden] {
    display: none;
  }
  .cc-banner[data-state="live"] [data-cc-banner-state="upcoming"],
  .cc-banner:not([data-state="live"]) [data-cc-banner-state="live"] {
    display: none;
  }
  .cc-banner[data-state="live"] .cc-live-dot {
    display: inline-block;
  }
  /* Live has no time to show, so the title takes its place on small screens. */
  .cc-banner[data-state="live"] .cc-title {
    display: block;
  }
  /* No-JS / pre-hydration default is the far CTA (7 days out is the common
     case); the script narrows it to "join" once the real time is known. */
  .cc-banner [data-cc-banner-cta="join"],
  .cc-banner[data-state="live"] [data-cc-banner-cta="far"],
  .cc-banner[data-cta="join"] [data-cc-banner-cta="far"] {
    display: none;
  }
  .cc-banner[data-state="live"] [data-cc-banner-cta="join"],
  .cc-banner[data-cta="join"] [data-cc-banner-cta="join"] {
    display: inline;
  }
</style>
