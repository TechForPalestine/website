---
// Animated Palestinian-flag-color divider, used as a recurring section
// separator on /membership and the homepage.
---

<div class="flag-stripe" aria-hidden="true"></div>

<style>
  @keyframes flagFlow {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: -200% 50%;
    }
  }

  .flag-stripe {
    height: 4px;
    margin: 0 0 10px;
    background: linear-gradient(
        to right,
        #101010,
        #ffffff,
        #157a3e,
        #ce1126,
        #101010,
        #ffffff,
        #157a3e,
        #ce1126,
        #101010
      )
      0% 0% / 200% 100%;
    animation: flagFlow 14s linear infinite;
    box-shadow: 0 0 0 1px rgba(16, 16, 16, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .flag-stripe {
      animation: none;
    }
  }
</style>
