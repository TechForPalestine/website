---
import Layout from "../layouts/Layout.astro";
import EndorsementForm from "../components/e4p/EndorsementForm.tsx";
import FAQAccordion from "../components/faq/FAQAccordion.tsx";
import "../styles/base.css";
import {
  container,
  display,
  headline,
  overline,
  body,
  band,
  primaryButton,
  inverseButton,
  ghostOnDarkButton,
} from "../utils/designClasses";
import TerminalCta from "../components/TerminalCta.astro";

// The three questions every request is weighed against.
const criteria = [
  {
    question: "Will it be impactful?",
    detail:
      "We look for campaigns and initiatives with meaningful potential to advance Palestinian rights or hold tech companies accountable.",
  },
  {
    question: "Does it relate to tech?",
    detail:
      "Our endorsements carry the most weight in the tech industry, and we prioritize campaigns where that community connection matters.",
  },
  {
    question: "Who are the other supporters?",
    detail:
      "We also consider other endorsing orgs and groups to assess the potential reach and impact of the campaign. Showing strong support from others in the movement strengthens your request.",
  },
];

// Rendered by the FAQ page's accordion with no client directive, so these
// ship as plain <details> HTML with no JavaScript.
const questions = [
  {
    question: "How long does the review process take?",
    answer:
      "We aim to review all requests within 5 to 7 days. We'll reach out if we need additional information.",
  },
  {
    question: "Can T4P projects apply for endorsements?",
    answer:
      "Yes. If you're already a T4P incubator project and are launching a specific campaign, you can request an endorsement. Tick the “existing Tech for Palestine project” box in the form and our review will reflect that context.",
  },
  {
    question: "What happens if our request is declined?",
    answer:
      "We'll let you know and, where possible, share the reason. Declinations are not permanent. If your campaign evolves or new information is available, you're welcome to reapply.",
  },
];
---

<Layout
  title="Endorsements | Tech for Palestine"
  description="Request an endorsement from Tech for Palestine for your campaign or organization. Learn what we look for and how the review process works."
>
  <main>
    <!-- Hero: the ask on the left, what an endorsement is (and isn't) on the right -->
    <section class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end lg:gap-14`}
      >
        <div class="min-w-0">
          <p class={overline}>Endorsements</p>
          <h1 class={`mt-5 max-w-[16ch] ${display}`}>
            Ask Tech for Palestine to back your campaign
          </h1>
          <p class={`mt-6 max-w-[52ch] text-ink-secondary ${body}`}>
            A T4P endorsement signals to the tech and Palestine advocacy communities that your
            campaign aligns with our values and goals. Read what we look for, then send your
            request.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="#request" class={primaryButton}>Request an endorsement</a>
            <p class="text-base text-ink-secondary">Reviewed within 5 to 7 days</p>
          </div>
        </div>

        <div class="min-w-0 rounded-lg bg-stone p-6 min-[810px]:p-8">
          <h2 class="text-[17px] font-bold leading-[1.35] text-ink">
            What a T4P endorsement means
          </h2>
          <p class="mt-3 max-w-[50ch] text-base leading-relaxed text-ink-secondary">
            A public statement of support for a specific campaign or initiative. It tells our
            community of thousands of tech workers that the campaign aligns with our values.
          </p>
          <dl class="mt-5 grid gap-4 border-t border-ink-divider pt-5 text-base leading-relaxed">
            <div>
              <dt class="font-bold text-ink">It is not funding</dt>
              <dd class="mt-1 text-ink-secondary">
                An endorsement does not imply financial support or an ongoing partnership.
              </dd>
            </div>
            <div>
              <dt class="font-bold text-ink">It is not full vetting</dt>
              <dd class="mt-1 text-ink-secondary">
                We don't fully vet every endorsement. Our review is based on available information
                and community knowledge, not exhaustive due diligence.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Criteria: a numbered list, one row per question -->
    <section aria-labelledby="criteria-heading" class={band}>
      <div class={`${container} py-16 min-[810px]:py-20`}>
        <p class={overline}>What we look for</p>
        <h2 id="criteria-heading" class={`mt-4 max-w-[22ch] ${headline}`}>
          Three questions we ask of every request
        </h2>

        <ol class="mt-10 divide-y divide-first-light-edge border-y border-first-light-edge">
          {
            criteria.map((item, index) => (
              <li class="grid gap-x-10 gap-y-2 py-7 md:grid-cols-[4rem_18rem_minmax(0,1fr)] md:items-baseline">
                <span
                  aria-hidden="true"
                  class="text-[28px] font-extrabold tabular-nums leading-none text-grove min-[810px]:text-[38px]"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="text-[19px] font-extrabold leading-snug text-ink min-[810px]:text-[21px]">
                  {item.question}
                </h3>
                <p class="max-w-[60ch] text-base leading-relaxed text-ink-secondary min-[810px]:text-lg">
                  {item.detail}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Process questions -->
    <section aria-labelledby="process-heading" class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14`}
      >
        <div class="min-w-0">
          <p class={overline}>Before you apply</p>
          <h2 id="process-heading" class={`mt-4 ${headline}`}>How review works</h2>
        </div>
        <ul class="min-w-0 divide-y divide-ink-divider border-y border-ink-divider">
          {
            questions.map((item) => (
              <li>
                <FAQAccordion question={item.question} answer={item.answer} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- The request form -->
    <section id="request" aria-labelledby="request-heading" class={`${band} scroll-mt-16`}>
      <div
        class={`${container} grid gap-10 py-16 min-[810px]:py-20 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14`}
      >
        <div class="min-w-0">
          <div class="lg:sticky lg:top-28">
            <p class={overline}>Submit a request</p>
            <h2 id="request-heading" class={`mt-4 max-w-[16ch] ${headline}`}>
              Tell us about your campaign
            </h2>
            <p class="mt-5 max-w-[45ch] text-[17px] leading-[1.7] text-ink-secondary">
              Every field is required unless it's marked optional. The team reads each request and
              will be in touch.
            </p>
          </div>
        </div>
        <div
          class="min-w-0 rounded-lg border border-first-light-edge bg-paper p-6 shadow-sm min-[810px]:p-10"
        >
          <EndorsementForm client:only="react" />
        </div>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page -->
    <TerminalCta heading="Building something bigger than a campaign?" headingId="incubator-heading">
      The T4P incubator backs projects for Palestinian liberation with mentorship, volunteers and
      connections.
      <Fragment slot="actions">
        <a href="/incubator" class={inverseButton}>Apply to the incubator</a>
        <a href="/membership" class={ghostOnDarkButton}>Become a member</a>
      </Fragment>
    </TerminalCta>
  </main>
</Layout>
