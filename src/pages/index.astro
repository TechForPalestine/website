---
import Layout from "../layouts/Layout.astro";
import SignUpForm from "../structures/SignUpForm.astro";
import CommunityCallBanner from "../components/CommunityCallBanner.astro";
import NewsletterPopup from "../components/home/NewsletterPopup";
import "../styles/base.css";

const stats = [
  { value: "90+", label: "Projects incubated" },
  { value: "3,000+", label: "Worldwide volunteers" },
  { value: "350+", label: "Entrepreneurs for Palestine" },
  { value: "50+", label: "Investors for Palestine" },
];

/** The lead project. Rendered wide, with its numbers at headline size. */
const leadProject = {
  name: "Upscrolled",
  href: "https://upscrolled.com/en/",
  logo: "/images/new-homepage/upscrolled_logo.webp",
  logoBg: "bg-white",
  metrics: ["#1 on the global App Store", "0 → 5M users in 7 months"],
  blurb:
    "The social platform with no shadowbans and no algorithmic games. Every voice gets equal reach.",
  credit: "Launched and scaled via T4P incubator and ecosystem partners.",
};

const projects = [
  {
    name: "Boycat",
    href: "https://www.boycat.io/vpn?utm_source=t4p&utm_medium=blog&utm_campaign=launch",
    logo: "/images/new-homepage/Boycat_logo.webp",
    logoBg: "bg-white",
    metrics: ["$500M in products boycotted", "3M+ users"],
    blurb:
      "Scan any product to check its ethical compliance and find alternatives in real time. Official BDS partner app.",
    credit: "Connected to BDS partnership through T4P.",
  },
  {
    name: "Thaura.ai",
    href: "https://www.thaura.ai/",
    logo: "/images/new-homepage/thaura.jpeg",
    logoBg: "bg-white",
    metrics: ["The ethical alternative to traditional LLMs"],
    blurb: "AI built ethically, designed around environmental, social, and privacy concerns.",
    credit: "Launched via T4P network to profitability.",
  },
  {
    name: "Find a Protest",
    href: "https://www.findaprotest.info/",
    logo: "/images/new-homepage/findaprotest_b.webp",
    logoBg: "bg-[#9FBAA9]",
    metrics: ["500k visits per week"],
    blurb:
      "Find and subscribe to protests in your area, powered by organizers, communities, and volunteer data collectors.",
    credit: "Refocused and volunteer-powered through T4P.",
  },
  {
    name: "Apricot",
    href: "https://apricotinternational.org/",
    logo: "/images/new-homepage/Apricot.webp",
    logoBg: "bg-white",
    metrics: ["$1M+ paid to placed talent"],
    blurb:
      "Connecting top tech talent from the Middle East, including Palestinian refugees, with US tech companies.",
    credit: "Customer introductions and strategic refocus via T4P.",
  },
  {
    name: "Newscord",
    href: "https://newscord.org/",
    logo: "/images/new-homepage/newscord.webp",
    logoBg: "bg-white",
    metrics: ["40k+ messages holding media to account for biased reporting"],
    blurb:
      "AI-powered news summaries across hundreds of sources, exposing media bias in every language.",
    credit: "MVP refocused and partnered with T4P ecosystem partners.",
  },
];

const support = [
  {
    title: "Volunteer network",
    body: "Access to 3,000+ skilled volunteers: engineers, marketers, designers and more, with a dedicated recruitment team to match you.",
  },
  {
    title: "Funding",
    body: "Small grants for most accepted projects. Simple process, no strings attached. We fund what works.",
  },
  {
    title: "Mentorship",
    body: "Strategy sessions and optional weekly dedicated mentors. Real guidance from people who have built before.",
  },
  {
    title: "Launch support",
    body: "Engineering, security and marketing expertise, coordinated launches, and a network of 10k+ early testers.",
  },
];

const press = [
  {
    outlet: "Stanford Social Innovation Review",
    href: "https://ssir.org/articles/entry/tech-against-genocide",
    image: "/images/press/ssir-tech-against-genocide.jpg",
    imageAlt: "Stanford Social Innovation Review article header",
    headline:
      "Tech for Palestine Business Incubator Supports Entrepreneurs Protecting Human Rights",
    objectPosition: "object-center",
  },
  {
    outlet: "TRT World",
    href: "https://www.trtworld.com/video/18268907",
    image: "/images/press/trt-world.jpeg",
    imageAlt: "TRT World broadcast still",
    headline:
      "Tech for Palestine initiative supports advocacy and accountability amid Israel's use of AI",
    objectPosition: "object-top",
  },
  {
    outlet: "Al Jazeera",
    href: "https://www.aljazeera.com/news/2026/1/29/whats-upscrolled-the-app-gaining-popularity-after-tiktoks-us-takeover",
    image: "/images/press/aljazeera-upscrolled.jpg",
    imageAlt: "Al Jazeera coverage of Upscrolled",
    headline: "What's UpScrolled, the app gaining popularity after TikTok's US takeover?",
    objectPosition: "object-top",
  },
  {
    outlet: "TechCrunch",
    href: "https://techcrunch.com/2024/01/02/tech-for-palestine-launches-to-provide-tools-and-projects-to-help-advocate-for-palestinians/",
    image: "/images/press/techcrunch-launch.jpg",
    imageAlt: "TechCrunch coverage of the Tech for Palestine launch",
    headline: "Tech for Palestine launches to provide tools to help support Palestinians",
    objectPosition: "object-center",
  },
  {
    outlet: "Tech Times",
    href: "https://www.techtimes.com/articles/300271/20240102/pro-palestinian-tech-workers-rally-behind-tech-for-palestine-coalition.htm",
    image: "/images/press/techtimes-rally.jpg",
    imageAlt: "Tech workers rallying in support of Palestine",
    headline: "Pro-Palestinian Tech Workers Rally Behind 'Tech for Palestine' Coalition",
    objectPosition: "object-center",
  },
  {
    outlet: "EUReports",
    href: "https://eureports.com/2026/04/barcelona-cements-its-position-as-epicentre-of-technological-solidarity-with-palestine/?_thumbnail_id=30865",
    image: "/images/press/eureports-barcelona.jpg",
    imageAlt: "Tech solidarity gathering in Barcelona",
    headline:
      "Barcelona cements its position as epicentre of technological solidarity with Palestine",
    objectPosition: "object-center",
  },
];

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-grove";
const pillPrimary = `inline-flex items-center justify-center rounded-pill bg-grove px-7 py-3.5 text-[15px] font-bold text-white transition-colors duration-150 hover:bg-grove-hover ${focusRing}`;
const pillGhost = `inline-flex items-center justify-center rounded-pill border border-ink-divider px-7 py-3.5 text-[15px] font-bold text-ink transition-colors duration-150 hover:border-grove hover:text-grove ${focusRing}`;
const cardBase = `group relative flex flex-col rounded-lg border border-ink-divider bg-paper transition-[border-color,box-shadow] duration-150 hover:border-grove hover:shadow-sm ${focusRing}`;
---

<Layout
  title="Tech For Palestine"
  description="A coalition of thousands of founders, engineers, product marketers, investors and other professionals working in support of Palestinian liberation. The T4P Incubator helps pro-Palestine advocates build, grow, and scale their work towards a Free Palestine."
  image="https://techforpalestine.org/happy-kids.jpg"
>
  <CommunityCallBanner theme="old" />
  <main>
    <!-- Hero -->
    <section
      class="flex flex-col-reverse bg-paper lg:grid lg:min-h-[calc(100vh-5rem)] lg:grid-cols-[1.05fr_1fr] lg:items-center"
    >
      <div class="px-6 py-12 md:px-12 lg:px-16 lg:py-10 lg:pr-12 2xl:px-28">
        <!-- Flag bars -->
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <div class="h-2 w-24 rounded-pill bg-[#268024]"></div>
          <div class="h-2 w-8 rounded-pill bg-[#e4312b]"></div>
          <div class="h-2 w-5 rounded-pill bg-nightfall"></div>
        </div>

        <h1
          class="mt-6 max-w-[20ch] text-[38px] font-extrabold leading-[1.05] tracking-[-0.015em] text-ink min-[810px]:text-[clamp(42px,4.2vw,54px)] min-[810px]:leading-[1.02]"
        >
          Join the tech movement behind <span class="text-grove"
            >90+ projects for Palestine</span
          >
        </h1>

        <p class="mt-5 max-w-[58ch] text-[19px] leading-[1.6] text-ink-secondary min-[810px]:text-[21px]">
          Tech for Palestine is a 501(c)(3) nonprofit starting and scaling initiatives for
          Palestinian liberation.
        </p>
        <p class="mt-3 max-w-[58ch] text-[17px] leading-[1.6] text-ink-secondary min-[810px]:text-[18px]">
          We support anyone with a meaningful idea, whether it is working against media censorship,
          using tech to aid protests, scaling boycotts, pushing for tech divestment, supporting
          Palestinian entrepreneurs, or anything else that contributes to a free Palestine.
        </p>

        <div class="mt-8">
          <a href="/incubator" class={pillPrimary}>Apply to the Incubator</a>
        </div>
      </div>

      <figure class="relative h-[min(26rem,45vh)] bg-stone lg:h-auto lg:self-stretch">
        <img
          src="/happy-kids.jpg"
          class="h-full w-full object-cover lg:absolute lg:inset-0"
          alt="Children in Gaza smiling for the camera"
          width="1600"
          height="1200"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent px-4 pb-3 pt-10 text-right text-xs font-medium text-white"
        >
          &copy; Motaz Azaiza
        </figcaption>
      </figure>
    </section>

    <!-- Measure band -->
    <section class="border-y border-first-light-edge bg-first-light">
      <div class="mx-auto max-w-[1400px] px-6 py-[clamp(2.25rem,4vw,3.25rem)] md:px-8">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-10 lg:grid-cols-4 lg:gap-x-0">
          {
            stats.map((stat, i) => (
              <div
                class:list={[
                  "flex flex-col lg:px-10",
                  i > 0 && "lg:border-l lg:border-first-light-edge",
                  i === 0 && "lg:pl-0",
                ]}
              >
                {/* Reversed visually so the number leads, without reversing the
                    dt/dd source order a definition list requires. */}
                <dt class="order-2 mt-2.5 text-[15px] leading-snug text-ink-secondary">
                  {stat.label}
                </dt>
                <dd class="order-1 text-[clamp(34px,4vw,44px)] font-extrabold leading-none tracking-[-0.02em] text-grove">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Portfolio -->
    <section class="bg-paper py-[clamp(4.5rem,8vw,7rem)]">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8">
        <header
          class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-12"
        >
          <div>
            <h2
              class="max-w-[18ch] text-[28px] font-extrabold leading-[1.1] tracking-[-0.015em] text-ink min-[810px]:text-[38px]"
            >
              Projects that came through T4P
            </h2>
          </div>
        </header>

        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          <!-- Lead project, rendered wide -->
          <a
            href={leadProject.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`${cardBase} p-7 md:col-span-2 md:p-9`}
          >
            <div class="flex items-center gap-3">
              <span
                class={`flex h-11 w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-[12px] border border-first-light-edge ${leadProject.logoBg}`}
              >
                <img
                  src={leadProject.logo}
                  alt=""
                  class="h-full w-full object-contain"
                  loading="lazy"
                />
              </span>
              <h3 class="text-[17px] font-bold text-ink">{leadProject.name}</h3>
            </div>

            <div class="mt-6 space-y-1.5">
              {
                leadProject.metrics.map((metric) => (
                  <p class="text-[clamp(22px,2.4vw,30px)] font-extrabold leading-[1.12] tracking-[-0.015em] text-ink">
                    {metric}
                  </p>
                ))
              }
            </div>

            <p class="mt-5 max-w-[56ch] text-[16px] leading-[1.65] text-ink-secondary">
              {leadProject.blurb}
            </p>

            <div
              class="mt-8 flex items-center justify-between gap-6 border-t border-ink-divider pt-4"
            >
              <span class="text-[14px] leading-snug text-ink-secondary">{leadProject.credit}</span>
              <span class="flex flex-shrink-0 items-center gap-1.5 text-[13px] font-bold text-grove">
                Visit <span aria-hidden="true">&#8599;</span>
              </span>
            </div>
          </a>

          {
            projects.map((project) => (
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class={`${cardBase} p-7`}
              >
                <div class="flex items-center gap-3">
                  <span
                    class={`flex h-11 w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-[12px] border border-first-light-edge ${project.logoBg}`}
                  >
                    <img
                      src={project.logo}
                      alt=""
                      class="h-full w-full object-contain p-0.5"
                      loading="lazy"
                    />
                  </span>
                  <h3 class="text-[17px] font-bold text-ink">{project.name}</h3>
                </div>

                <div class="mt-5 space-y-1">
                  {project.metrics.map((metric) => (
                    <p class="text-[19px] font-extrabold leading-[1.2] tracking-[-0.01em] text-ink">
                      {metric}
                    </p>
                  ))}
                </div>

                <p class="mt-4 text-[15px] leading-[1.65] text-ink-secondary">{project.blurb}</p>

                <div class="mt-auto flex items-end justify-between gap-4 pt-7">
                  <span class="text-[13px] leading-snug text-ink-secondary">{project.credit}</span>
                  <span class="flex flex-shrink-0 items-center gap-1.5 text-[13px] font-bold text-grove">
                    Visit <span aria-hidden="true">&#8599;</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="mt-12 flex flex-wrap gap-3">
          <a href="/projects" class={pillPrimary}>Browse all projects</a>
          <a href="/incubator" class={pillGhost}>Apply to the Incubator</a>
        </div>
      </div>
    </section>

    <!-- What projects get -->
    <section class="border-y border-first-light-edge bg-first-light py-[clamp(4rem,7vw,6rem)]">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8">
        <header class="max-w-[50ch]">
          <h2
            class="text-[28px] font-extrabold leading-[1.1] tracking-[-0.015em] text-ink min-[810px]:text-[38px]"
          >
            How we help projects succeed
          </h2>

        </header>

        <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            support.map((item) => (
              <li class="border-t border-grove/25 pt-5">
                <h3 class="text-[19px] font-extrabold leading-snug tracking-[-0.01em] text-ink">
                  {item.title}
                </h3>
                <p class="mt-2.5 text-[16px] leading-[1.65] text-ink-secondary">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Press -->
    <section class="bg-paper py-[clamp(3.5rem,6vw,5.5rem)]">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8">
        <header>
          <h2
            class="text-[28px] font-extrabold leading-[1.1] tracking-[-0.015em] text-ink min-[810px]:text-[38px]"
          >
            In the press
          </h2>
        </header>

        <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            press.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class={`${cardBase} overflow-hidden`}
              >
                <div class="aspect-[16/9] w-full overflow-hidden bg-stone">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    class:list={["h-full w-full object-cover", item.objectPosition]}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-grove-deep">
                    {item.outlet}
                  </p>
                  <p class="mt-3 text-[17px] font-bold leading-[1.35] text-ink">{item.headline}</p>
                  <span class="mt-6 flex items-center gap-1.5 text-[13px] font-bold text-grove">
                    Read article <span aria-hidden="true">&#8599;</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page -->
    <section class="bg-paper pb-[clamp(3rem,5vw,4rem)]">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8">
        <div class="rounded-md bg-nightfall px-6 py-[clamp(3rem,5vw,4.5rem)] sm:px-10 lg:px-16">
          <h2
            class="max-w-[16ch] text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.08] tracking-[-0.015em] text-white"
          >
            You have seen what we have built. Now build with us.
          </h2>

          <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-0">
            <div class="lg:pr-14">
              <h3 class="text-[19px] font-extrabold tracking-[-0.01em] text-white">Support us</h3>
              <p class="mt-3 max-w-[46ch] text-[16px] leading-[1.7] text-white/70">
                Your donation helps us hire professionals, strengthen existing projects, and launch
                new initiatives for a free Palestine.
              </p>
              <a
                href="/donate"
                class="mt-7 inline-flex items-center justify-center rounded-pill bg-white px-7 py-3.5 text-[15px] font-bold text-nightfall transition-colors duration-150 hover:bg-first-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Donate
              </a>
            </div>

            <div class="border-t border-white/15 pt-10 lg:border-l lg:border-t-0 lg:pl-14 lg:pt-0">
              <h3 class="text-[19px] font-extrabold tracking-[-0.01em] text-white">Get involved</h3>
              <p class="mt-3 max-w-[46ch] text-[16px] leading-[1.7] text-white/70">
                Join a working community of engineers, designers, marketers and organizers. There
                are many ways to contribute your skills.
              </p>
              <a
                href="/get-involved"
                class="mt-7 inline-flex items-center justify-center rounded-pill border border-white/45 px-7 py-3.5 text-[15px] font-bold text-white transition-colors duration-150 hover:border-white hover:bg-white hover:text-nightfall focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Get involved
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mailing list -->
    <section id="mailing-list" class="bg-paper pb-[clamp(3.5rem,6vw,5rem)]">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8">
        <div class="mx-auto max-w-3xl rounded-lg bg-stone px-6 py-10 sm:px-10">
          <SignUpForm />
        </div>
      </div>
    </section>
  </main>
  <NewsletterPopup client:only="react" />
  <script>
    import { FOOTER_SECTION_ID } from "../utils/newsletterPopup";
    import { watchSignupSuccess } from "../utils/watchSignupSuccess";

    const bottomForm = document.getElementById(FOOTER_SECTION_ID);
    if (bottomForm) {
      watchSignupSuccess(bottomForm, () =>
        window.plausible("Newsletter Signup", { props: { source: "footer" } })
      );
    }
  </script>
</Layout>
