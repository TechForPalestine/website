---
import Layout from "../layouts/Layout.astro";
import FAQList from "../components/faq/FAQList.tsx";
import "../styles/base.css";
import {
  container,
  headline,
  overline,
  body,
  inverseButton,
  ghostOnDarkButton,
} from "../utils/designClasses";
import TerminalCta from "../components/TerminalCta.astro";
import { fetchNotionFAQ, type FaqItem } from "../store/notionClient";
import { reportAndFlush } from "../lib/report-error";
import { faqPageSchema } from "../utils/seo";

// Fetched here so the questions and answers are in the server HTML (and the
// FAQPage schema) rather than only appearing after the island loads. If Notion
// fails, the island falls back to fetching /api/faq itself.
// `?showAll=yes` previews hidden entries for editors, as /api/faq already does.
const showAll = Astro.url.searchParams.get("showAll") === "yes";
let faqs: FaqItem[] = [];
try {
  faqs = await fetchNotionFAQ(showAll, Astro.locals);
} catch (error) {
  reportAndFlush(error, { context: "faq page: fetchNotionFAQ" }, Astro.locals);
}

const plainText = (faq: FaqItem) => faq.answer.map((segment) => segment.plain_text).join("");
// Draft previews must not publish hidden answers as structured data, and a
// FAQPage with no questions is invalid.
const faqSchema = faqPageSchema(
  faqs.map((faq) => ({ question: faq.question, answer: plainText(faq) }))
);
const schema = !showAll && faqSchema.mainEntity.length > 0 ? [faqSchema] : [];
---

<Layout
  title="FAQ - Tech for Palestine"
  schema={schema}
  description="Answers about Tech for Palestine: our mission, the T4P Incubator, membership, volunteering, and how tech workers support Palestinian liberation."
>
  <main>
    <!-- Hero -->
    <section class="pb-12 pt-16 min-[810px]:pb-16 min-[810px]:pt-20">
      <div class={container}>
        <p class={overline}>Frequently asked questions</p>
        <h1
          class="mt-5 max-w-[18ch] text-[38px] font-extrabold leading-[1.05] text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]"
        >
          Straight answers about working for Palestinian liberation
        </h1>
        <p class={`mt-6 max-w-[60ch] text-ink-secondary ${body}`}>
          What Tech for Palestine does, how projects get support, and where your skills fit in. Open
          any question below; every answer comes from the people who run T4P.
        </p>
      </div>
    </section>

    <!-- Questions -->
    <section
      aria-labelledby="questions-heading"
      class="border-t border-ink-divider pb-16 pt-12 min-[810px]:pb-20 min-[810px]:pt-16"
    >
      <div
        class={`${container} grid gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14`}
      >
        <div class="min-w-0">
          <h2 id="questions-heading" class={`${headline} lg:sticky lg:top-28`}>
            What people ask us
          </h2>
        </div>
        <div class="min-w-0">
          <FAQList faqs={faqs} client:load />
        </div>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page -->
    <TerminalCta
      padTop={false}
      heading="Still have a question? Ask a person."
      headingId="ask-heading"
    >
      Write to the team and someone will get back to you. Members can also ask in the vetted member
      chat, where the people building the projects answer directly.
      <Fragment slot="actions">
        <a href="/contact" class={inverseButton}>Contact us</a>
        <a href="/membership" class={ghostOnDarkButton}>Become a member</a>
      </Fragment>
    </TerminalCta>
  </main>
</Layout>
