---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import "../styles/base.css";
import {
  container,
  display,
  headline,
  overline,
  body,
  focusRing,
  band,
  primaryButton,
  ghostButton,
  inlineLink,
  inverseButton,
} from "../utils/designClasses";
import { canonicalUrl, ORGANIZATION_ID, SITE_ORIGIN } from "../utils/seo";
import TerminalCta from "../components/TerminalCta.astro";
import TestimonialCard from "../components/membership/TestimonialCard.astro";
import MailtoFallback from "../components/MailtoFallback.astro";
import {
  CORRECTIONS_EMAIL,
  CREDITS,
  FINDINGS,
  MEMBERSHIP_PITCH,
  METHODOLOGY_INTRO,
  METHODOLOGY_NOTES,
  METHODOLOGY_TRACKS,
  PRESS_EMAIL,
  QUOTES,
  RELATED_PROJECTS,
  REPORT_PDF,
  REPORT_READ_HREF,
  REPORT_PUBLISHED,
  REPORT_SUMMARY,
  REPORT_TITLE,
  SUMMARY_PDF,
  findingHref,
  findingLinkLabel,
  pdfMeta,
} from "../data/wikipediaReport";

const pdfLabel = pdfMeta();
const pdfUrl = `${SITE_ORIGIN}${REPORT_PDF.href}`;
const publishedLabel = REPORT_PUBLISHED
  ? new Date(`${REPORT_PUBLISHED}T12:00:00Z`).toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;

const hasQuotes = QUOTES.length > 0;
const pdfButtonLabel = REPORT_PDF.size ? `Download PDF (${REPORT_PDF.size})` : "Download PDF";

// Report is an Article subtype; the PDF rides along as its encoding so search
// and AI crawlers can find the document itself, not just this page.
const reportSchema = {
  "@context": "https://schema.org",
  "@type": "Report",
  headline: REPORT_TITLE,
  description: REPORT_SUMMARY,
  url: canonicalUrl(REPORT_READ_HREF),
  inLanguage: "en",
  ...(REPORT_PUBLISHED ? { datePublished: REPORT_PUBLISHED } : {}),
  author: { "@id": ORGANIZATION_ID, "@type": "NonprofitOrganization", name: "Tech for Palestine" },
  publisher: {
    "@id": ORGANIZATION_ID,
    "@type": "NonprofitOrganization",
    name: "Tech for Palestine",
  },
  about: { "@type": "WebSite", name: "Wikipedia", url: "https://www.wikipedia.org" },
  encoding: {
    "@type": "MediaObject",
    contentUrl: pdfUrl,
    encodingFormat: "application/pdf",
    ...(REPORT_PDF.size ? { contentSize: REPORT_PDF.size } : {}),
  },
};

const ordinal = (i: number) => String(i + 1).padStart(2, "0");
---

<Layout
  title={`${REPORT_TITLE}: Report - Tech for Palestine`}
  description="Twenty years of documented attacks on Wikipedia, and what they mean for the information you get from search and AI. A report by Tech for Palestine."
  schema={[reportSchema]}
  noindex
>
  <!-- noindex (and the sitemap exclusion in astro.config.mjs) stay until the
       TODO(comms) launch blockers in src/data/wikipediaReport.ts are resolved. -->
  <main>
    <!-- Hero: the claim and the download, both above the fold -->
    <section
      aria-labelledby="report-heading"
      class="pb-14 pt-16 min-[810px]:pb-16 min-[810px]:pt-20"
    >
      <div class={container}>
        <div class="min-w-0">
          <p class={overline}>
            New report{
              publishedLabel && (
                <>
                  {" "}
                  · <time datetime={REPORT_PUBLISHED}>{publishedLabel}</time>
                </>
              )
            }
          </p>
          <h1 id="report-heading" class={`mt-5 max-w-[14ch] ${display}`}>{REPORT_TITLE}</h1>
          <p class={`mt-6 max-w-[52ch] text-ink-secondary ${body}`}>{REPORT_SUMMARY}</p>

          <div class="mt-9 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap">
            <a href={REPORT_READ_HREF} data-track-report-read="hero" class={primaryButton}>
              <Icon name="mdi:book-open-page-variant-outline" class="h-4 w-4" aria-hidden="true" />
              Read the report online
            </a>
            <a
              href={REPORT_PDF.href}
              download
              data-track-report-download="hero"
              class={ghostButton}
            >
              <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
              {pdfButtonLabel}
            </a>
          </div>

          <p class="mt-6 text-[15px] text-ink-secondary">
            Press:
            <a href={`mailto:${PRESS_EMAIL}`} data-mailto-fallback class={inlineLink}>
              {PRESS_EMAIL}
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Key findings: titles only; each opens to its figure, summary and a link
         to its section in the online report. Native <details>, no JS to toggle. -->
    <section
      id="findings"
      aria-labelledby="findings-heading"
      class="scroll-mt-6 pb-16 min-[810px]:pb-20"
    >
      <div class={container}>
        <h2 id="findings-heading" class={`border-t border-ink-divider pt-14 ${headline}`}>
          Key findings
        </h2>

        <ol class="mt-10 border-b border-ink-divider">
          {
            FINDINGS.map((finding, i) => (
              <li id={finding.id} class="scroll-mt-6 border-t border-ink-divider">
                <details class="group">
                  <summary
                    class={`flex cursor-pointer list-none items-start gap-4 py-6 text-ink transition-colors hover:text-grove motion-reduce:transition-none min-[810px]:gap-6 min-[810px]:py-7 [&::-webkit-details-marker]:hidden ${focusRing}`}
                  >
                    <span class="w-8 shrink-0 pt-0.5 text-[17px] font-bold tabular-nums text-ink-muted group-hover:text-grove min-[810px]:text-[19px]">
                      {ordinal(i)}
                    </span>
                    <h3 class="min-w-0 flex-1 text-[21px] font-extrabold leading-snug min-[810px]:text-[24px]">
                      {finding.title}
                    </h3>
                    <Icon
                      name="mdi:plus"
                      class="mt-1 h-6 w-6 shrink-0 text-grove transition-transform duration-200 ease-out group-open:rotate-45 motion-reduce:transition-none"
                      aria-hidden="true"
                    />
                  </summary>

                  <div class="grid gap-x-12 gap-y-4 pb-10 pl-12 min-[810px]:grid-cols-[12rem_minmax(0,1fr)] min-[810px]:pl-14">
                    {finding.stat && (
                      <div>
                        <p class="text-[44px] font-extrabold tabular-nums leading-none text-grove min-[810px]:text-[52px]">
                          {finding.stat}
                        </p>
                        <p class="mt-3 max-w-[22ch] text-[15px] leading-snug text-ink-secondary">
                          {finding.statLabel}
                        </p>
                      </div>
                    )}
                    <div
                      class:list={[
                        "min-w-0 max-w-[65ch]",
                        !finding.stat && "min-[810px]:col-span-2",
                      ]}
                    >
                      <p class="text-[17px] leading-[1.7] text-ink-secondary min-[810px]:text-[18px]">
                        {finding.body}
                      </p>
                      <a
                        href={findingHref(finding)}
                        class={`mt-4 inline-flex items-center gap-1.5 text-[15px] ${inlineLink}`}
                      >
                        Read more: {findingLinkLabel(finding)}
                        <Icon name="mdi:arrow-right" class="h-4 w-4" aria-hidden="true" />
                      </a>
                    </div>
                  </div>
                </details>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap">
          <a href={REPORT_READ_HREF} data-track-report-read="findings" class={primaryButton}>
            <Icon name="mdi:book-open-page-variant-outline" class="h-4 w-4" aria-hidden="true" />
            Read the full report online
          </a>
          <a
            href={REPORT_PDF.href}
            download
            data-track-report-download="findings"
            class={ghostButton}
          >
            <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
            {pdfButtonLabel}
          </a>
        </div>
      </div>
    </section>

    {
      hasQuotes && (
        <section aria-labelledby="voices-heading" class={band}>
          <div class={`${container} py-16 min-[810px]:py-20`}>
            <h2 id="voices-heading" class={overline}>
              What people are saying
            </h2>
            <div class="mt-8 grid gap-5 min-[810px]:grid-cols-2 min-[810px]:[&>*:last-child:nth-child(odd)]:col-span-2">
              {QUOTES.map((q) => (
                <TestimonialCard quote={q.quote} name={q.name} role={q.role} image={q.image} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- How we did this: method, sources and credits -->
    <section
      id="methodology"
      aria-labelledby="method-heading"
      class="scroll-mt-6 py-16 min-[810px]:py-20"
    >
      <div class={container}>
        <h2
          id="method-heading"
          class:list={[headline, !hasQuotes && "border-t border-ink-divider pt-14"]}
        >
          How we did this
        </h2>

        <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
          <div
            class="min-w-0 max-w-[65ch] text-[17px] leading-[1.7] text-ink-secondary min-[810px]:text-[18px]"
          >
            {METHODOLOGY_INTRO.map((paragraph) => <p class="mb-5">{paragraph}</p>)}

            <p class="mb-4 font-bold text-ink">We worked on three tracks:</p>
            <ul class="mb-8 space-y-4 border-y border-ink-divider py-5">
              {
                METHODOLOGY_TRACKS.map((track) => (
                  <li class="grid grid-cols-[1.25rem_minmax(0,1fr)]">
                    <span class="font-bold text-grove" aria-hidden="true">
                      ·
                    </span>
                    <span>
                      <strong class="font-bold text-ink">{track.lead}</strong>
                      {track.text && <> {track.text}</>}{" "}
                      <a href={track.ref.href} class={inlineLink}>
                        ({track.ref.label})
                      </a>
                    </span>
                  </li>
                ))
              }
            </ul>

            {
              METHODOLOGY_NOTES.map((note) => (
                <p class="mb-5">
                  {note.text}
                  {note.ref && (
                    <>
                      {" "}
                      <a href={note.ref.href} class={inlineLink}>
                        ({note.ref.label})
                      </a>
                    </>
                  )}
                </p>
              ))
            }

            <p class="mt-8 rounded-lg bg-stone p-6 text-ink">
              This is a living document. We update it when corrections or new information come in.
              Found an error? Email{" "}
              <a
                href={`mailto:${CORRECTIONS_EMAIL}?subject=${encodeURIComponent("Wikipedia report: correction")}`}
                data-mailto-fallback
                class={inlineLink}>{CORRECTIONS_EMAIL}</a
              >.
            </p>
          </div>

          <aside aria-labelledby="credits-heading" class="min-w-0 self-start">
            <h3 id="credits-heading" class={overline}>Who made this</h3>
            <dl class="mt-4 divide-y divide-ink-divider border-y border-ink-divider">
              {
                CREDITS.map((credit) => (
                  <div class="py-4">
                    <dt class="text-[15px] text-ink-secondary">{credit.role}</dt>
                    <dd class="mt-1 text-[17px] font-bold leading-snug text-ink">{credit.names}</dd>
                  </div>
                ))
              }
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- Press (band): contact and downloadable material -->
    <section aria-labelledby="press-heading" class={band}>
      <div
        class={`${container} grid gap-x-12 gap-y-6 py-16 min-[810px]:py-20 lg:grid-cols-[12rem_minmax(0,1fr)]`}
      >
        <h2 id="press-heading" class={`${overline} lg:pt-2`}>Press</h2>
        <div class="min-w-0">
          <p class="text-[17px] text-ink-secondary">Press contact</p>
          <a
            href={`mailto:${PRESS_EMAIL}`}
            data-mailto-fallback
            class={`mt-1 inline-flex items-center gap-2 break-all text-[21px] min-[810px]:text-[24px] ${inlineLink}`}
          >
            <Icon name="mdi:email-outline" class="h-6 w-6 shrink-0" aria-hidden="true" />
            {PRESS_EMAIL}
          </a>

          <ul class="mt-8 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap">
            {
              SUMMARY_PDF && (
                <li>
                  <a
                    href={SUMMARY_PDF.href}
                    download
                    data-track-report-download="press-summary"
                    class={ghostButton}
                  >
                    <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
                    Executive summary ({pdfMeta(SUMMARY_PDF)})
                  </a>
                </li>
              )
            }
            <li>
              <a
                href={REPORT_PDF.href}
                download
                data-track-report-download="press"
                class={ghostButton}
              >
                <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
                Full report ({pdfLabel})
              </a>
            </li>
            <li>
              <a href="/media" class={ghostButton}>Logos and brand assets</a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Related T4P projects -->
    <section aria-labelledby="related-heading" class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]`}
      >
        <h2 id="related-heading" class={`max-w-[18ch] ${headline}`}>
          T4P projects countering media bias and propaganda
        </h2>
        <ul class="divide-y divide-ink-divider border-y border-ink-divider">
          {
            RELATED_PROJECTS.map((project) => (
              <li class="py-6">
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-1.5 text-[21px] ${inlineLink}`}
                >
                  {project.name}
                  <Icon name="mdi:open-in-new" class="h-4 w-4" aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
                <p class="mt-2 max-w-[60ch] text-[17px] leading-relaxed text-ink-secondary">
                  {project.description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <TerminalCta heading="Become a T4P member" headingId="report-cta-heading" padTop={false}>
      {MEMBERSHIP_PITCH.map((paragraph, i) => <p class:list={[i > 0 && "mt-4"]}>{paragraph}</p>)}
      <Fragment slot="actions">
        <a href="/membership" class={inverseButton}>Become a T4P member</a>
      </Fragment>
    </TerminalCta>
  </main>
  <MailtoFallback />
</Layout>

<script>
  // A link straight to a finding (/wikipedia-report#finding-ai) should land
  // on it open, not on a bare title.
  function openFindingFromHash(): void {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const details = document.getElementById(id)?.querySelector("details");
    if (details) details.open = true;
  }
  openFindingFromHash();
  window.addEventListener("hashchange", openFindingFromHash);

  document.querySelectorAll<HTMLElement>("[data-track-report-read]").forEach((link) => {
    link.addEventListener("click", () => {
      if (typeof window.plausible === "undefined") return;
      window.plausible("Wikipedia Report Read Online", {
        props: { location: link.dataset.trackReportRead ?? "unknown" },
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-track-report-download]").forEach((link) => {
    link.addEventListener("click", () => {
      if (typeof window.plausible === "undefined") return;
      window.plausible("Wikipedia Report Download", {
        props: { location: link.dataset.trackReportDownload ?? "unknown" },
      });
    });
  });
</script>
