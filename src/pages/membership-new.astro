---
import { getEnv } from "../utils/getEnv";
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeNavbar from "../components/home/HomeNavbar.astro";
import MembershipMain from "../components/membership/MembershipMain.astro";

const membershipLive = getEnv("MEMBERSHIP_LIVE", Astro.locals) === "true";
---

<HomeLayout
  title="Become a Member of Tech for Palestine | Support Our Mission"
  description="Join the coalition working on initiatives for Palestinian liberation. Members drive and sustain our work through dues, teams, and community."
  noindex={true}
>
  <HomeNavbar membershipLive={membershipLive} alwaysVisible />

  <main class="pt-20">
    <MembershipMain membershipLive={membershipLive} designSystem />
  </main>
</HomeLayout>
