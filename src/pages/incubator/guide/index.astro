---
// Start of the project leader guide: the welcome tab of the incubator's Google
// Doc, word for word (src/data/incubator-guide-welcome.md), then the contents.
// The chapters are src/content/incubator-guide/*.md, rendered by ./[slug].astro.
import Layout from "../../../layouts/Layout.astro";
import TerminalCta from "../../../components/TerminalCta.astro";
import GuideShell from "../../../components/incubator-guide/GuideShell.astro";
import GuidePager from "../../../components/incubator-guide/GuidePager.astro";
import ApplyTracking from "../../../components/incubator-guide/ApplyTracking.astro";
import { getGuideChapters } from "../../../components/incubator-guide/guideData";
import {
  adjacentLinks,
  chapterHref,
  guideLinks,
} from "../../../components/incubator-guide/guideNav";
import { APPLY_URL, GUIDE_URL } from "../../../data/incubator";
import {
  GUIDE_DESCRIPTION,
  GUIDE_TITLE,
  INCUBATOR_EMAIL,
  WELCOME_HEADING,
} from "../../../data/incubatorGuide";
import { Content as Welcome } from "../../../data/incubator-guide-welcome.md";
import { breadcrumbListSchema } from "../../../components/wikipedia-report/reportNav";
import { canonicalUrl, SITE_ORIGIN } from "../../../utils/seo";
import {
  display,
  focusRing,
  ghostOnDarkButton,
  inlineLinkOnDark,
  inverseButton,
  overline,
} from "../../../utils/designClasses";
import "../../../styles/base.css";
import "../../../styles/incubator-guide.css";

const chapters = await getGuideChapters();
const links = guideLinks(chapters);
const { next } = adjacentLinks(chapters, null);

const breadcrumbs = breadcrumbListSchema([
  { name: "Home", url: `${SITE_ORIGIN}/` },
  { name: "Incubator", url: canonicalUrl("/incubator") },
  { name: GUIDE_TITLE, url: canonicalUrl(GUIDE_URL) },
]);
---

<Layout
  title={`${GUIDE_TITLE} - Incubator - Tech for Palestine`}
  description={GUIDE_DESCRIPTION}
  schema={[breadcrumbs]}
>
  <main>
    <GuideShell links={links} currentSlug={null}>
      <article aria-labelledby="guide-page-heading">
        <header class="mb-10 max-w-[45rem] min-[810px]:mb-12">
          <p class={overline}>Incubator · {GUIDE_TITLE}</p>
          <h1 id="guide-page-heading" class={`mt-4 ${display}`}>{WELCOME_HEADING}</h1>
        </header>

        <div class="guide-prose">
          <Welcome />
        </div>

        <nav aria-labelledby="contents-heading" class="mt-14 max-w-[45rem] min-[810px]:mt-16">
          <h2
            id="contents-heading"
            class="text-[26px] font-extrabold leading-[1.2] text-ink min-[810px]:text-[30px]"
          >
            Contents
          </h2>
          <ol class="mt-6 border-b border-ink-divider">
            {
              chapters.map((chapter, i) => (
                <li class="border-t border-ink-divider">
                  <a
                    href={chapterHref(chapter.slug)}
                    class={`group grid grid-cols-[2rem_minmax(0,1fr)] gap-x-2 rounded-sm py-4 ${focusRing}`}
                  >
                    <span class="text-[17px] font-extrabold text-grove" aria-hidden="true">
                      {i + 1}
                    </span>
                    <span class="text-[19px] font-extrabold leading-snug text-ink transition-colors group-hover:text-grove motion-reduce:transition-none">
                      {chapter.title}
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </article>

      <div class="mt-16 max-w-[45rem] min-[810px]:mt-20">
        <GuidePager prev={null} next={next} />
      </div>
    </GuideShell>

    <TerminalCta heading="Ready to apply?" headingId="guide-cta-heading" padTop={false}>
      <p>
        The application takes 10 to 30 minutes. If it looks promising, we'll invite you to a
        30-minute interview, and we aim to decide within 10 days.
      </p>
      <Fragment slot="actions">
        <a href={APPLY_URL} data-track-incubator-click="guide-overview" class={inverseButton}>
          Apply to the incubator
        </a>
        <a href="/incubator" class={ghostOnDarkButton}>About the incubator</a>
      </Fragment>
      <Fragment slot="footnote">
        Questions? Email <a href={`mailto:${INCUBATOR_EMAIL}`} class={inlineLinkOnDark}
          >{INCUBATOR_EMAIL}</a
        >.
      </Fragment>
    </TerminalCta>
  </main>
  <ApplyTracking />
</Layout>
