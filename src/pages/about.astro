---
import SignUpForm from "../structures/SignUpForm.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/base.css";
import {
  container,
  headline,
  overline,
  body,
  primaryButton,
  ghostButton,
  inlineLink,
} from "../utils/designClasses";

// Hero mosaic. The first photo leads full-width; the other four sit beneath it
// as an even row (2x2 on phones), so the set reads as one composed block
// rather than the scattered, offset columns of the old layout.
const heroPhotos = [
  {
    src: "/protest-dc.jpg",
    alt: "Palestine solidarity march in Washington DC with demonstrators carrying Palestinian flags near Capitol building",
    width: 6000,
    height: 4000,
  },
  {
    src: "/gaza-sky-geeks.webp",
    alt: "A woman working on a laptop at Gaza Sky Geeks technology center",
    width: 2400,
    height: 1600,
  },
  {
    src: "/jerusalem.jpg",
    alt: "Dome of the Rock in Jerusalem, Palestine, silhouetted against dramatic sunset sky with orange and purple clouds",
    width: 3000,
    height: 2000,
  },
  {
    src: "/olive-branch-thobe.jpg",
    alt: "Woman in traditional Palestinian embroidered thobe holding an olive branch, wearing ornate gold coin headpiece against olive tree background",
    width: 612,
    height: 408,
  },
  {
    src: "/gaza-father-child.avif",
    alt: "Silhouette of a Palestinian father playfully tossing child in the air against Gaza cityscape at sunset with vibrant orange and purple sky",
    width: 896,
    height: 564,
  },
];
const [leadPhoto, ...rowPhotos] = heroPhotos;
---

<Layout title="About">
  <main>
    <!-- Hero -->
    <section class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-14`}
      >
        <div class="min-w-0">
          <h1
            class="text-[38px] font-extrabold leading-[1.05] text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]"
          >
            Let's make tech a driving force for Palestinian freedom and liberation
          </h1>

          <p
            class="mt-8 max-w-[30ch] text-[22px] font-extrabold leading-snug text-grove min-[810px]:text-[28px]"
          >
            Technology should disrupt the status quo — not serve it.
          </p>
          <p class={`mt-6 max-w-[65ch] text-ink-secondary ${body}`}>
            For decades, the narrative about Palestine has been shaped by selective historical
            accounts and an occupying force that restricts access to the reality on the ground.
          </p>
          <p class={`mt-4 max-w-[65ch] text-ink-secondary ${body}`}>
            The community at Tech for Palestine is shifting the conversation towards equality and
            justice, by cultivating a garden of projects and services that shut down genocidal
            speech, enable people to speak up for Palestinian freedom, scale Palestinian activism
            with technology, and cultivate fierce advocates for Palestine within the Tech community.
          </p>

          <div class="mt-10 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap">
            <a href="/projects" class={primaryButton}>
              Explore Projects
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"
                ></path>
              </svg>
            </a>
            <a href="/get-involved" class={ghostButton}>
              Get Involved
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"
                ></path>
              </svg>
            </a>
            <a href="/discord-invite" class={ghostButton}>
              Join Discord
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="grid min-w-0 grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
          <img
            src={leadPhoto.src}
            alt={leadPhoto.alt}
            width={leadPhoto.width}
            height={leadPhoto.height}
            fetchpriority="high"
            class="col-span-2 aspect-[3/2] h-auto w-full rounded-lg bg-stone object-cover sm:col-span-4"
          />
          {
            rowPhotos.map((photo) => (
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="aspect-square h-auto w-full rounded-md bg-stone object-cover"
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Vision & Mission -->
    <section
      aria-labelledby="vision-heading"
      class="border-y border-first-light-edge bg-first-light"
    >
      <div class={`${container} py-16 min-[810px]:py-20`}>
        <h2 id="vision-heading" class={overline}>Vision</h2>
        <p class={`mt-5 max-w-4xl ${headline}`}>
          A free Palestine, a tech industry that actively participates in liberation, and a world
          where all people enjoy equal dignity, justice, and human rights.
        </p>

        <div
          class="mt-12 grid gap-x-12 gap-y-5 border-t border-first-light-edge pt-12 lg:mt-16 lg:grid-cols-[12rem_minmax(0,1fr)] lg:pt-16"
        >
          <h2 id="mission-heading" class={`${overline} lg:pt-2`}>Mission</h2>
          <div class="max-w-[65ch]">
            <p class={`text-ink ${body}`}>
              T4P exists to accelerate the liberation of Palestine, transform the tech industry, and
              contribute to movements for justice everywhere by:
            </p>
            <ul
              class="mt-5 list-disc space-y-3 pl-6 text-lg leading-relaxed text-ink-secondary marker:text-grove"
            >
              <li>
                building, educating, and mobilizing a community of tech users, workers, executives,
                founders, and investors
              </li>
              <li>using our tech skills to scale the movement for Palestine</li>
              <li>
                pushing the tech industry towards liberatory and ethical practices, policies,
                technologies, and culture
              </li>
              <li>developing new ethical technology and tools</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- How we work -->
    <section aria-labelledby="how-heading" class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14`}
      >
        <div class="min-w-0">
          <h2 id="how-heading" class={headline}>How we work</h2>
        </div>
        <div class="min-w-0">
          <ul class="max-w-[65ch] divide-y divide-ink-divider border-y border-ink-divider">
            <li class={`py-6 text-ink ${body}`}>
              We connect project leaders to communities of volunteers
            </li>
            <li class={`py-6 text-ink ${body}`}>
              We mentor, provide office hours, and support start-up projects aimed at ending
              apartheid, minimizing media bias, encouraging boycotts, and more
            </li>
            <li class={`py-6 text-ink ${body}`}>
              We create a community of pro-Palestinian techies to get involved in causes they
              believe in and help Palestinians get hired
            </li>
          </ul>
          <a href="/projects" class={`mt-8 ${primaryButton}`}>
            Learn more about our Projects
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Our Founder -->
    <section
      aria-labelledby="founder-heading"
      class="border-y border-first-light-edge bg-first-light"
    >
      <div
        class={`${container} grid gap-x-12 gap-y-5 py-16 min-[810px]:py-20 lg:grid-cols-[12rem_minmax(0,1fr)]`}
      >
        <h2 id="founder-heading" class={`${overline} lg:pt-2`}>Our Founder</h2>
        <div class="max-w-[65ch] space-y-4">
          <p class={`text-ink ${body}`}>
            Paul Biggar is a tech founder and software engineer. He founded Tech for Palestine, <a
              href="https://circleci.com"
              class={inlineLink}>CircleCI</a
            > and
            <a href="https://darklang.com" class={inlineLink}>Darklang</a>.
          </p>
          <p class={`text-ink-secondary ${body}`}>
            Read why <a href="https://blog.paulbiggar.com/i-cant-sleep/" class={inlineLink}
              >Paul couldn't sleep</a
            > — the post that started Tech for Palestine.
          </p>
        </div>
      </div>
    </section>

    <!-- Closing image -->
    <div class={`${container} pt-16 min-[810px]:pt-20`}>
      <img
        src="/gaza-children-playing-ocean.jpg"
        alt="Palestinian children playing joyfully in ocean waves at sunset on Gaza's Mediterranean coastline"
        width="900"
        height="603"
        loading="lazy"
        decoding="async"
        class="aspect-[5/2] h-auto w-full rounded-lg bg-stone object-cover"
      />
    </div>

    <!-- Newsletter sign-up -->
    <section class="py-16 min-[810px]:py-20">
      <div class="mx-auto max-w-screen-md px-6">
        <SignUpForm />
      </div>
    </section>
  </main>
</Layout>
