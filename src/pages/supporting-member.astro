---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import LegacyJoinSection from "../components/membership/LegacyJoinSection";
import LegacyWaiverNote from "../components/membership/LegacyWaiverNote";
import TestimonialsMarquee from "../components/TestimonialsMarquee.astro";
import { membershipBenefits, showcaseProjects } from "../data/membershipBenefits";
import "../styles/base.css";

const logoWallLabel = `Projects supported by Tech for Palestine: ${showcaseProjects
  .map((p) => p.name)
  .join(", ")}`;
---

<Layout
  title="Become a Supporting Member - Tech for Palestine"
  description="Support Tech for Palestine financially without joining a team. Supporting Members fund initiatives for Palestinian liberation, get event invites, and receive project updates."
>
  <main>
    <PageHeader overline="Tech for Palestine" title="Become a Supporting Member" />

    <div class="mx-auto max-w-6xl px-6 pb-24 pt-6 sm:px-8">
      <!-- Hero: opening copy beside the photo, rather than stacked -->
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_440px] lg:gap-16">
        <p class="max-w-[700px] text-lg leading-relaxed text-zinc-700">
          Tech for Palestine's coalition of founders, engineers, investors and other professionals
          are helping Palestine advocates scale their work. Tens of thousands of Israeli <em
            >hasbara</em
          > (propaganda) projects exist, so we're creating thousands of initiatives for Palestinian
          liberation.
        </p>

        <img
          src="/images/membership/supporting-panel.webp"
          alt="A speaker addressing the audience during a Tech for Palestine panel discussion"
          class="w-full rounded-2xl shadow-sm ring-1 ring-zinc-900/5"
          width="1600"
          height="1068"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Reach -->
      <p class="mt-14 text-2xl font-extrabold tracking-tight text-zinc-900 md:text-3xl">
        10M+ Users Across 90+ Projects
      </p>
      <ul
        class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5"
        aria-label={logoWallLabel}
      >
        {
          showcaseProjects.map((project) => (
            <li class="flex h-[80px] items-center justify-center rounded-xl border border-zinc-200 bg-white px-3 py-2 transition-colors hover:border-zinc-300">
              <img
                src={project.logo}
                alt=""
                width="220"
                height="64"
                loading="lazy"
                decoding="async"
                class="max-h-[40px] w-full max-w-[130px] object-contain"
              />
            </li>
          ))
        }
      </ul>

      <!-- Pitch -->
      <p class="mt-12 max-w-[700px] text-lg leading-relaxed text-zinc-700">
        Want to support T4P's work, but don't have time to get involved in teams or join the
        community? Become a Supporting Member to support our work financially, receive invites to
        events and get updates about our progress:
      </p>

      <!-- Comparison table -->
      <div class="mt-9 hidden overflow-hidden rounded-2xl border border-zinc-200 shadow-sm md:block">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">
            Benefits included with Supporting Membership compared with full Membership
          </caption>
          <thead class="bg-zinc-50">
            <tr>
              <th scope="col" class="px-6 py-4 text-sm font-semibold text-zinc-500"></th>
              <th
                scope="col"
                class="w-[170px] px-4 py-4 text-center text-sm font-semibold text-zinc-900"
                >Supporting Member</th
              >
              <th
                scope="col"
                class="w-[170px] px-4 py-4 text-center text-sm font-semibold text-zinc-900"
                >Member</th
              >
            </tr>
          </thead>
          <tbody>
            {
              membershipBenefits.map((benefit) => (
                <tr class="border-t border-zinc-200 transition-colors hover:bg-[#f9fafb]">
                  <th scope="row" class="px-6 py-4 font-normal text-zinc-800">
                    {benefit.label}
                  </th>
                  {[benefit.supporting, benefit.member].map((included) => (
                    <td class="px-4 py-4 text-center">
                      {included ? (
                        <>
                          <svg
                            class="inline-block text-[#168039]"
                            width="20"
                            height="20"
                            viewBox="0 0 20 20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M4 10.5 8 14.5 16 6" />
                          </svg>
                          <span class="sr-only">Included</span>
                        </>
                      ) : (
                        <>
                          <span class="text-zinc-400" aria-hidden="true">
                            —
                          </span>
                          <span class="sr-only">Not included</span>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul class="mt-8 flex flex-col gap-3 md:hidden">
        {
          membershipBenefits.map((benefit) => (
            <li class="rounded-xl border border-zinc-200 bg-zinc-50 p-4 transition-colors hover:border-zinc-300">
              <p class="text-zinc-800">{benefit.label}</p>
              <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-zinc-600">
                <span>
                  Supporting Member:{" "}
                  <span
                    class={benefit.supporting ? "font-semibold text-[#168039]" : "text-zinc-400"}
                  >
                    {benefit.supporting ? "Included" : "Not included"}
                  </span>
                </span>
                <span>
                  Member:{" "}
                  <span class={benefit.member ? "font-semibold text-[#168039]" : "text-zinc-400"}>
                    {benefit.member ? "Included" : "Not included"}
                  </span>
                </span>
              </p>
            </li>
          ))
        }
      </ul>

      <!-- CTAs -->
      <div class="mt-11 flex flex-wrap items-center gap-5">
        <a
          href="#join"
          data-track-join-click="primary_cta"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#168039] px-6 py-3 font-semibold text-white shadow-sm transition-all duration-150 hover:bg-[#116b2f] hover:shadow-md active:bg-[#116b2f] active:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#168039] focus-visible:ring-offset-2"
        >
          Become a Supporting Member
        </a>
        <a
          href="/donate"
          class="font-medium text-zinc-600 underline decoration-1 underline-offset-2 transition-colors hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2 focus-visible:rounded-sm"
        >
          Donate without joining
        </a>
      </div>

      <LegacyWaiverNote className="mt-11 max-w-[700px]" />

      <div class="mt-14">
        <LegacyJoinSection client:only="react" tier="supporting" />
      </div>
    </div>

    <TestimonialsMarquee />
  </main>

  <script>
    document.querySelectorAll<HTMLAnchorElement>("[data-track-join-click]").forEach((link) => {
      link.addEventListener("click", () => {
        if (typeof window.plausible === "undefined") return;
        window.plausible("Membership Join Click", {
          props: {
            cta_location: link.dataset.trackJoinClick ?? "unknown",
            destination: link.getAttribute("href") ?? "",
          },
        });
      });
    });
  </script>
</Layout>
