---
import Layout from "../layouts/Layout.astro";
import JoinFlow from "../components/membership/JoinFlow";
import { showcaseProjects } from "../data/membershipBenefits";
import { getTestimonials } from "../data/testimonials";
import "../styles/base.css";

// Card copy matches the approved mockup verbatim — concise, card-length
// phrasing distinct from the longer sentences in membershipBenefits.ts.
const supportingFeatures = [
  "Dues fund Palestinian liberation initiatives",
  "Invites to community events",
  "Exclusive project updates",
  "(Optionally) Mentor projects",
];
const memberBaseFeatures = [
  "Dues fund Palestinian liberation initiatives",
  "Invites to community events",
  "Exclusive project updates",
];
const memberOnlyFeatures = ["Volunteer or mentor on projects", "Join the private member chat"];

// Supporting members fund both T4P itself and the projects it incubates, so
// this page shows every voice — members and project founders alike. "Founder"
// is relabeled "Project Lead" here, a page-specific title that doesn't belong
// in the shared data other pages also read. Cecile and Hani & Said are held
// back for now — not yet approved for this page.
const HIDDEN_FOR_NOW = ["Cecile", "Hani & Said Chihabi"];
const featuredTestimonials = getTestimonials()
  .filter((t) => !HIDDEN_FOR_NOW.includes(t.name))
  .map((t) => ({ ...t, role: t.role.replace("Founder", "Project Lead") }));

const logoWallLabel = `Projects supported by Tech for Palestine: ${showcaseProjects
  .map((p) => p.name)
  .join(", ")}`;
---

<Layout
  title="Become a Supporting Member - Tech for Palestine"
  description="Support Tech for Palestine financially without joining a team. Supporting Members fund initiatives for Palestinian liberation, get event invites, and receive project updates."
  hideDonatePopout
>
  <main>
    <div class="mx-auto max-w-[1280px] px-6 py-16 min-[810px]:py-20 sm:px-8">
      <!-- Hero: opening copy beside a reach stat card, photo tucked under the copy -->
      <div class="grid grid-cols-1 items-stretch gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14">
        <div class="max-w-[700px]">
          <h1 class="mb-6 text-[38px] font-extrabold leading-[1.05] tracking-tight text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]">
            Become a Supporting Member
          </h1>
          <p class="text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]">
            Tech for Palestine helps projects scale through our coalition of founders, investors,
            engineers, marketers, and more. We create projects &amp; provide free volunteers,
            operational support, mentorship, and funding to pro-Palestine projects that seek our
            help.
          </p>
          <p class="mt-3.5 text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]">
            Thousands of Israeli <em>hasbara</em> (propaganda) projects exist, so we're building thousands
            of initiatives for Palestinian liberation.
          </p>

          <img
            src="/images/membership/supporting-panel.webp"
            alt="A speaker addressing the audience during a Tech for Palestine panel discussion"
            class="mt-8 w-full rounded-2xl shadow-sm ring-1 ring-ink/5"
            width="1600"
            height="1068"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Reach stat card -->
        <div class="flex flex-col rounded-[10px] border border-[#e0e1da] border-t-[3px] border-t-[#157A3E] bg-white p-7 shadow-sm">
          <p class="text-[34px] font-extrabold leading-[1.12] tracking-tight text-ink">
            <span class="text-[#157A3E]">10M+</span> Users Across <span class="text-[#157A3E]"
              >90+</span
            > Projects
          </p>
          <ul class="mt-[22px] flex flex-1 flex-col gap-3" aria-label={logoWallLabel}>
            {
              showcaseProjects.map((project) => (
                <li class="flex-1">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit ${project.name}`}
                    class="flex h-full min-h-[60px] items-center justify-center rounded-lg border border-ink-divider bg-stone px-3 transition-colors hover:border-[#157A3E] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2"
                  >
                    <img
                      src={project.logo}
                      alt=""
                      width="220"
                      height="64"
                      loading="lazy"
                      decoding="async"
                      class="max-h-[44px] w-auto max-w-[70%] object-contain"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Value proposition: two-tier comparison -->
    <div class="mt-16 border-y border-[#D2E4D6] bg-[#E7F2E9] py-16">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        <h2 class="max-w-[45ch] text-[28px] font-extrabold leading-tight tracking-tight text-ink min-[810px]:text-[38px]">
          Want to support T4P's work, but don't have time to get involved?
        </h2>
        <p class="mt-4 max-w-[65ch] text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]">
          Become a Supporting Member to fund our work, receive invites to events, and get updates
          about our progress:
        </p>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 md:items-stretch">
          <!-- Supporting Member card -->
          <div
            class="flex flex-col overflow-hidden rounded-lg border-2 border-[#157A3E] bg-white shadow-sm"
          >
            <div class="bg-[#157A3E] px-7 py-6">
              <h3 class="text-xl font-extrabold tracking-tight text-white md:text-2xl">
                Fund the Movement
              </h3>
            </div>
            <ul class="flex flex-1 flex-col px-7 py-2">
              {
                supportingFeatures.map((feature) => (
                  <li class="flex min-h-[64px] items-center gap-4 border-b border-zinc-100 last:border-b-0">
                    <svg
                      class="h-6 w-6 shrink-0 rounded-full bg-[#157A3E] p-1 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                    <span class="text-[17px] leading-snug text-ink">{feature}</span>
                  </li>
                ))
              }
            </ul>
            <div class="px-7 pb-7 pt-3">
              <a
                href="#join"
                data-track-join-click="primary_cta"
                class="block rounded-full bg-[#157A3E] px-6 py-3.5 text-center font-semibold text-white shadow-sm transition-all duration-150 hover:bg-[#0e5a2f] hover:shadow-md active:bg-[#0e5a2f] active:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2"
              >
                Become a Supporting Member
              </a>
            </div>
          </div>

          <!-- Full Member card -->
          <div
            class="flex flex-col overflow-hidden rounded-lg border border-ink-divider bg-white shadow-sm"
          >
            <div class="border-b border-ink-divider px-7 py-6">
              <h3 class="text-xl font-extrabold tracking-tight text-ink md:text-2xl">
                Build the Movement
              </h3>
            </div>
            <ul class="flex flex-1 flex-col px-7 py-2">
              {
                memberBaseFeatures.map((feature) => (
                  <li class="flex min-h-[64px] items-center gap-4 border-b border-zinc-100">
                    <svg
                      class="h-6 w-6 shrink-0 rounded-full bg-[#157A3E] p-1 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                    <span class="text-[17px] leading-snug text-ink">{feature}</span>
                  </li>
                ))
              }
              <li class="pb-1 pt-5">
                <span class="text-[17px] font-extrabold text-[#157A3E]">And:</span>
              </li>
              {
                memberOnlyFeatures.map((feature) => (
                  <li class="flex min-h-[64px] items-center gap-4 border-b border-zinc-100 last:border-b-0">
                    <svg
                      class="h-6 w-6 shrink-0 rounded-full bg-[#157A3E] p-1 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                    <span class="text-[17px] leading-snug text-ink">{feature}</span>
                  </li>
                ))
              }
            </ul>
            <div class="px-7 pb-7 pt-3">
              <a
                href="/membership"
                class="block rounded-full bg-[#101010] px-6 py-3.5 text-center font-semibold text-white shadow-sm transition-all duration-150 hover:bg-[#2c2d29] hover:shadow-md active:bg-[#2c2d29] active:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#101010] focus-visible:ring-offset-2"
              >
                Become a Member
              </a>
            </div>
          </div>
        </div>

        <p class="mt-8 text-center text-sm text-ink-secondary">
          Questions? Contact{" "}
          <a
            href="mailto:membership@techforpalestine.org"
            class="font-semibold text-[#157A3E] underline decoration-1 underline-offset-2 hover:text-[#0e5a2f]"
          >
            membership@techforpalestine.org
          </a>
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-[1280px] px-6 pb-24 pt-16 sm:px-8">
      <div class="flex flex-wrap items-center gap-5">
        <a
          href="/donate"
          class="font-medium text-ink-secondary underline decoration-1 underline-offset-2 transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:rounded-sm"
        >
          Donate without joining
        </a>
      </div>

      <div id="join" class="mx-auto mt-14 max-w-[560px] scroll-mt-24">
        <JoinFlow client:only="react" fixedTier="supporting" />
        <div class="mt-6 rounded-lg bg-[#F2F3EE] p-6">
          <div class="mb-3 text-[11px] font-bold uppercase tracking-[0.12em] text-[#157A3E]">
            Suggested amount
          </div>
          <p class="text-[18px] leading-relaxed text-ink">
            Dues are pay-what-you-can. We suggest dues equal to one hour of income (or 1/2000th of
            your annual income), which can be calculated at checkout.
          </p>
        </div>
      </div>
    </div>

    <!-- Testimonials: matches the mockup's white section with a bottom rule -->
    <section id="voices" class="border-b border-ink-divider bg-white">
      <div class="mx-auto max-w-[1280px] px-6 py-14 sm:px-8">
        <h2 class="text-[28px] font-extrabold leading-tight text-ink md:text-[38px]">
          Your support in action.
        </h2>
        <p class="mt-3 max-w-2xl text-[17px] text-ink-secondary">
          Project leaders and members on their time inside the coalition.
        </p>
        <div class="mt-9 grid grid-cols-1 gap-5 md:grid-cols-2">
          {
            featuredTestimonials.map((t) => (
              <figure class="rounded-lg border border-[#D2E4D6] border-t-[3px] border-t-[#157A3E] bg-white p-7">
                <blockquote class="text-[19px] leading-relaxed tracking-tight text-ink">
                  “{t.quote}”
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3">
                  {t.headshots ? (
                    <div class="relative h-[34px] w-[34px] shrink-0">
                      <img
                        src={t.headshots[0]}
                        alt=""
                        width="26"
                        height="26"
                        loading="lazy"
                        decoding="async"
                        class="absolute left-0 top-0 h-[22px] w-[22px] rounded-full object-cover ring-1 ring-white"
                      />
                      <img
                        src={t.headshots[1]}
                        alt=""
                        width="26"
                        height="26"
                        loading="lazy"
                        decoding="async"
                        class="absolute bottom-0 right-0 h-[22px] w-[22px] rounded-full object-cover ring-1 ring-white"
                      />
                    </div>
                  ) : (
                    <img
                      src={t.headshot}
                      alt=""
                      width="34"
                      height="34"
                      loading="lazy"
                      decoding="async"
                      class="block h-[34px] w-[34px] rounded-full object-cover"
                    />
                  )}
                  <span class="block leading-snug">
                    <strong class="block text-[13px] font-bold text-ink">{t.name}</strong>
                    <span class="text-[13px] text-ink-secondary">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page, carrying the primary ask -->
    <div class="bg-[#101010] px-6 py-20 sm:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-8 text-center">
        <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-white md:text-[32px]">
          Help fund marketing support, engineering, volunteers, and mentorship for T4P projects
        </h2>
        <a
          href="#join"
          data-track-join-click="secondary_cta"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-white px-8 py-3.5 font-semibold text-ink shadow-sm transition-all duration-150 hover:bg-zinc-100 hover:shadow-md active:bg-zinc-100 active:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#101010]"
        >
          Become a Supporting Member
        </a>
      </div>
    </div>
  </main>

  <script>
    document.querySelectorAll<HTMLAnchorElement>("[data-track-join-click]").forEach((link) => {
      link.addEventListener("click", () => {
        if (typeof window.plausible === "undefined") return;
        window.plausible("Membership Join Click", {
          props: {
            cta_location: link.dataset.trackJoinClick ?? "unknown",
            destination: link.getAttribute("href") ?? "",
          },
        });
      });
    });
  </script>
</Layout>
