---
// Reader index for the online report: the executive summary and a way into
// Section 1, inside ReportShell so the contents rail (md+) or the phone
// Contents bar is visible from the start. Server-rendered like the rest of
// the site (CSP nonces, nav A/B test); do not prerender.
import { Icon } from "astro-icon/components";
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TerminalCta from "../../components/TerminalCta.astro";
import ReportShell from "../../components/wikipedia-report/ReportShell.astro";
import NewTabHint from "../../components/wikipedia-report/NewTabHint.astro";
import InfluenceMap from "../../components/wikipedia-report/InfluenceMap.astro";
import ReportScripts from "../../components/wikipedia-report/ReportScripts.astro";
import { getReportEntries } from "../../components/wikipedia-report/reportData";
import { splitAtMapAnchor } from "../../components/wikipedia-report/fullText";
import {
  breadcrumbListSchema,
  entryHref,
  INDEX_SLUG,
} from "../../components/wikipedia-report/reportNav";
import {
  OVERVIEW_HREF,
  READER_SUBTITLE,
  READER_TITLE,
  REPORT_PDF_HREF,
} from "../../components/wikipedia-report/reportMeta";
import {
  MEMBERSHIP_PITCH,
  REPORT_PDF,
  REPORT_PUBLISHED,
  pdfMeta,
} from "../../data/wikipediaReport";
import { REPORT_BASE_PATH, REPORT_FULL_PATH } from "../../utils/wikipediaReportLinks";
import { canonicalUrl, SITE_ORIGIN } from "../../utils/seo";
import {
  container,
  display,
  focusRing,
  ghostButton,
  headline,
  inverseButton,
  overline,
  primaryButton,
} from "../../utils/designClasses";
import "../../styles/base.css";
import "../../styles/wikipedia-report.css";

const summary = await getEntry("wikipediaReport", INDEX_SLUG);
if (!summary) {
  return new Response(null, { status: 404 });
}

const entries = await getReportEntries();
const first = entries.find((entry) => entry.slug !== INDEX_SLUG);
const { Content } = await render(summary);

// The influence map sits just above "Our Claims in Brief". The summary is
// generated (scripts/wikipedia-report/convert.mjs rewrites it on every run),
// so rather than edit it we split its HTML body at that heading. The converter
// emits plain HTML with no inline styles or scripts, so set:html is safe. If
// the heading moves, the summary renders whole and the map follows it.
const summaryParts = splitAtMapAnchor(summary.body ?? "");

const pdfLabel = pdfMeta();
// pdfMeta() is just "PDF" until comms fill in the size and page count.
const pdfDetails = Boolean(REPORT_PDF.size || REPORT_PDF.pages);
const publishedLabel = REPORT_PUBLISHED
  ? new Date(`${REPORT_PUBLISHED}T12:00:00Z`).toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;

const breadcrumbs = breadcrumbListSchema([
  { name: "Home", url: `${SITE_ORIGIN}/` },
  { name: READER_TITLE, url: canonicalUrl(REPORT_BASE_PATH) },
]);
---

<Layout
  title={`${READER_TITLE} ${READER_SUBTITLE}: Read the report - Tech for Palestine`}
  description="Read the full report online: twenty years of documented attacks on Wikipedia, and how they shape what search engines and AI tell you. By Tech for Palestine."
  schema={[breadcrumbs]}
>
  <main>
    <header aria-labelledby="report-heading" class="pt-16 min-[810px]:pt-20">
      <div class={container}>
        <p class={overline}>Report · Tech for Palestine</p>
        <h1 id="report-heading" class={`mt-5 max-w-[16ch] ${display}`}>
          {READER_TITLE}
          <span class="mt-2 block font-normal text-ink-secondary">{READER_SUBTITLE}</span>
        </h1>
        <p class="mt-6 text-[16px] text-ink-secondary">
          A report by Tech for Palestine{
            publishedLabel && (
              <>
                {" "}
                · <time datetime={REPORT_PUBLISHED}>{publishedLabel}</time>
              </>
            )
          }
        </p>

        <div
          class="report-no-print mt-8 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap"
        >
          <a
            href={REPORT_PDF_HREF}
            download
            data-track-report-download="reader-index"
            class={primaryButton}
          >
            <Icon name="mdi:download" class="h-4 w-4" aria-hidden="true" />
            Download PDF
          </a>
          <a href={OVERVIEW_HREF} class={ghostButton}>Key findings</a>
          <a href={REPORT_FULL_PATH} data-track-report-read="reader-index-full" class={ghostButton}>
            Read it all on one page
          </a>
        </div>
        {pdfDetails && <p class="mt-3 text-[15px] text-ink-secondary">{pdfLabel}</p>}
      </div>
    </header>

    <ReportShell entries={entries} currentSlug={INDEX_SLUG} currentTitle={summary.data.title}>
      <section aria-labelledby="summary-heading" class="pb-10">
        <div class="max-w-[45rem]">
          <h2 id="summary-heading" class={headline}>{summary.data.title}</h2>
          {
            summaryParts ? (
              <>
                <div class="report-prose mt-8">
                  <Fragment set:html={summaryParts[0]} />
                </div>
                <div class="my-12">
                  <InfluenceMap />
                </div>
                <div class="report-prose">
                  <Fragment set:html={summaryParts[1]} />
                  <NewTabHint />
                </div>
              </>
            ) : (
              <>
                <div class="report-prose mt-8">
                  <Content />
                  <NewTabHint />
                </div>
                <div class="mt-12">
                  <InfluenceMap />
                </div>
              </>
            )
          }
        </div>
      </section>

      {
        first && (
          <a
            href={entryHref(first.slug)}
            rel="next"
            class={`report-no-print group inline-flex min-h-[44px] items-center gap-3 rounded-sm text-[19px] font-extrabold text-grove transition-colors hover:text-grove-hover motion-reduce:transition-none min-[810px]:text-[21px] ${focusRing}`}
          >
            Start reading{first.label && `: ${first.label}`}
            <Icon
              name="mdi:arrow-right"
              class="h-5 w-5 transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transition-none"
              aria-hidden="true"
            />
          </a>
        )
      }
    </ReportShell>

    <div class="report-no-print">
      <TerminalCta heading="Become a T4P member" headingId="report-cta-heading" padTop={false}>
        {MEMBERSHIP_PITCH.map((paragraph, i) => <p class:list={[i > 0 && "mt-4"]}>{paragraph}</p>)}
        <Fragment slot="actions">
          <a href="/membership" class={inverseButton}>Become a T4P member</a>
        </Fragment>
      </TerminalCta>
    </div>
  </main>
  <ReportScripts />
</Layout>
