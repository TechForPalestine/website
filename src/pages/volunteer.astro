---
import Socials from "../components/Socials.astro";
import OpenRoles from "../components/volunteer/OpenRoles.tsx";
import Layout from "../layouts/Layout.astro";
import "../styles/base.css";

const MEMBERSHIP_URL = "/membership";
const INTRO_CALL_URL = "https://calendly.com/d/ctpm-sw2-yvc/t4p-intro-call";
const DISCORD_URL = "https://techforpalestine.org/discord-invite";

const container = "mx-auto max-w-[1280px] px-6 sm:px-8";
const h2 =
  "text-[28px] font-extrabold leading-tight tracking-tight text-ink min-[810px]:text-[38px]";
const lede = "text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]";
const overline = "mb-4 text-xs font-bold uppercase tracking-[0.14em] text-[#2F5C3F]";
const bandShell = "border-y border-[#D2E4D6] bg-[#E7F2E9]";
const primaryButton =
  "inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#157A3E] px-7 py-3.5 font-bold text-white shadow-sm transition-colors duration-150 hover:bg-[#0e5a2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2 motion-reduce:transition-none";
const textLink =
  "shrink-0 rounded-sm text-[17px] font-bold text-[#157A3E] underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-[#0e5a2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2 motion-reduce:transition-none";

const reasons = [
  {
    title: "Make a direct impact",
    description:
      "Apply your skills to projects that amplify Palestinian voices and uplift the cause.",
  },
  {
    title: "Join a global network",
    description:
      "Technologists, creatives, entrepreneurs, professionals, and activists united by a commitment to justice and human dignity for Palestinians.",
  },
  {
    title: "Grow professionally",
    description: "Work on meaningful initiatives that create lasting positive change.",
  },
  {
    title: "Find your people",
    description:
      "Connect with like-minded individuals through community spaces, events, and collaborative projects.",
  },
  {
    title: "Turn concern into action",
    description: "Measurable outcomes for Palestinian communities.",
  },
];

const expectations = [
  "A commitment of your time and expertise.",
  "Active collaboration and clear communication.",
  "Timely notification of any changes to your availability.",
];

const notExpected = [
  "Daily or rigid meeting attendance, unless essential for your role.",
  "Exclusive commitment. You are welcome to engage in other initiatives.",
];
---

<Layout title="Get Involved">
  <main>
    <!-- Hero: the ask, beside a real photo of the T4P volunteer team -->
    <section class={`${container} py-16 min-[810px]:py-20`}>
      <div
        class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14"
      >
        <div class="max-w-[700px]">
          <h1
            class="mb-6 text-[38px] font-extrabold leading-[1.05] tracking-tight text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]"
          >
            Join our Volunteer Community!
          </h1>
          <p class={lede}>Become a member to make a meaningful impact for Palestine.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={MEMBERSHIP_URL} class={primaryButton}>Become a Member</a>
            <a href="#open-roles" class={textLink}>
              See open roles <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
        <img
          src="/images/new-homepage/support/team.webp"
          alt="Tech for Palestine volunteers in T4P shirts and keffiyehs on stage at the 2026 Barcelona conference"
          width="1600"
          height="1067"
          class="block h-auto w-full rounded-lg shadow-sm"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <!-- Band: live open roles from the Hub -->
    <section id="open-roles" class={`${bandShell} scroll-mt-24`}>
      <div class={`${container} py-14 min-[810px]:py-16`}>
        <p class={overline}>Open roles</p>
        <h2 class={`max-w-[24ch] ${h2}`}>Current volunteer needs</h2>
        <p class={`mt-4 max-w-[65ch] ${lede}`}>
          Roles open right now across coalition projects and Tech for Palestine teams. Project roles
          go through our volunteer application; T4P team roles are filled through membership.
        </p>
        <div class="mt-10">
          <OpenRoles client:only="react" />
        </div>
      </div>
    </section>

    <!-- Why volunteer: heading on the left, ruled list of reasons on the right -->
    <section class={`${container} py-16 min-[810px]:py-20`}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <h2 class={h2}>Why Volunteer with Us?</h2>
        </div>
        <dl class="border-b border-ink-divider">
          {
            reasons.map((item) => (
              <div class="grid grid-cols-1 gap-1 border-t border-ink-divider py-5 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
                <dt class="text-[17px] font-bold leading-snug text-ink">{item.title}</dt>
                <dd class="max-w-[60ch] text-[17px] leading-relaxed text-ink-secondary">
                  {item.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Band: expectations, both sides of them -->
    <section class={bandShell}>
      <div class={`${container} py-14 min-[810px]:py-16`}>
        <p class={overline}>Volunteer expectations</p>
        <h2 class={`max-w-[28ch] ${h2}`}>What we expect, and what we don't.</h2>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 md:items-start">
          <div class="rounded-lg border border-[#D2E4D6] bg-white p-7">
            <h3 class="text-xl font-extrabold tracking-tight text-ink">What we expect</h3>
            <ul class="mt-4">
              {
                expectations.map((item) => (
                  <li class="border-t border-ink-divider py-4 text-[17px] leading-relaxed text-ink-secondary first:border-t-0 first:pt-2">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-lg border border-[#D2E4D6] bg-white p-7">
            <h3 class="text-xl font-extrabold tracking-tight text-ink">What we don't expect</h3>
            <ul class="mt-4">
              {
                notExpected.map((item) => (
                  <li class="border-t border-ink-divider py-4 text-[17px] leading-relaxed text-ink-secondary first:border-t-0 first:pt-2">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Next steps: one row per action, link on the right -->
    <section class={`${container} py-16 min-[810px]:py-20`}>
      <h2 class={h2}>Next Steps</h2>
      <ul class="mt-8 max-w-[860px] border-b border-ink-divider">
        <li
          class="flex flex-col gap-3 border-t border-ink-divider py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
        >
          <div>
            <p class="text-[19px] font-bold text-ink">Become a Tech for Palestine member</p>
            <p class="mt-1 text-[17px] text-ink-secondary">
              Or <a
                href={INTRO_CALL_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-[#157A3E] underline decoration-1 underline-offset-4 hover:text-[#0e5a2f]"
                >schedule an intro call</a
              > to learn more!
            </p>
          </div>
          <a href={MEMBERSHIP_URL} class={textLink}>
            Become a member <span aria-hidden="true">→</span>
          </a>
        </li>
        <li
          class="flex flex-col gap-3 border-t border-ink-divider py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
        >
          <div>
            <p class="text-[19px] font-bold text-ink">Join our Discord server</p>
            <p class="mt-1 text-[17px] text-ink-secondary">And come along to community calls.</p>
          </div>
          <a href={DISCORD_URL} class={textLink}>
            Join Discord <span aria-hidden="true">→</span>
          </a>
        </li>
        <li
          class="flex flex-col gap-4 border-t border-ink-divider py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
        >
          <p class="text-[19px] font-bold text-ink">Follow us on social media</p>
          <Socials />
        </li>
      </ul>
    </section>

    <!-- Terminal CTA: the one dark block on the page, carrying the primary ask -->
    <section class="bg-[#101010] px-6 py-20 sm:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-8 text-center">
        <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-white md:text-[32px]">
          Your time and skills can truly make a difference.
        </h2>
        <a
          href={MEMBERSHIP_URL}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-white px-8 py-3.5 font-bold text-ink shadow-sm transition-colors duration-150 hover:bg-[#F2F3EE] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#101010] motion-reduce:transition-none"
        >
          Become a Member
        </a>
      </div>
    </section>
  </main>
</Layout>
