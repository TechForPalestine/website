---
import Layout from "../layouts/Layout.astro";
import "../styles/base.css";
import {
  container,
  headline,
  overline,
  body,
  focusRing,
  inverseButton,
  inlineLink,
} from "../utils/designClasses";
import TerminalCta from "../components/TerminalCta.astro";
import CopyEmailButton from "../components/CopyEmailButton.astro";

const routeLink = `inline-flex min-h-[44px] items-center gap-2 font-bold text-grove transition-colors hover:text-grove-hover motion-reduce:transition-none ${focusRing}`;

// The routing table. Each row answers "who are you, and where do you go?"
// `email` is shown as visible text beside the page link when a direct
// address exists for that need.
const routes = [
  {
    id: "press",
    need: "Press and media",
    detail:
      "Journalists and media professionals: press releases, coverage and the media contact live on our Media page.",
    href: "/media",
    action: "Visit the Media page",
    email: "media@techforpalestine.org",
  },
  {
    id: "endorsements",
    need: "Endorsements",
    detail:
      "Seeking a T4P endorsement for your campaign or organization? See what we look for, then submit a request.",
    href: "/endorsements",
    action: "Request an endorsement",
  },
  {
    id: "incubator",
    need: "Building a project",
    detail:
      "Launching or scaling a project for Palestinian liberation? The incubator offers mentorship, volunteers and connections.",
    href: "/incubator",
    action: "Apply to the incubator",
  },
  {
    id: "volunteer",
    need: "Volunteering",
    detail: "Put your skills to work on projects that need them.",
    href: "/volunteer",
    action: "Find volunteer roles",
  },
];
---

<Layout
  title="Contact Us | Tech for Palestine"
  description="Get in touch with Tech for Palestine: general questions, media inquiries, or a request for an endorsement of your campaign."
>
  <main>
    <!-- Hero: the general inbox is the most common need, so it sits beside the headline -->
    <section class="py-16 min-[810px]:py-20">
      <div
        class={`${container} grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end lg:gap-14`}
      >
        <div class="min-w-0">
          <h1
            class="text-[38px] font-extrabold leading-[1.05] text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]"
          >
            Contact Tech for Palestine
          </h1>
          <p class={`mt-6 max-w-[52ch] text-ink-secondary ${body}`}>
            Questions, press, endorsements or a project for Palestinian liberation: find the right
            channel below and reach the people who can help.
          </p>
        </div>

        <div class="min-w-0 rounded-lg bg-stone p-6 min-[810px]:p-8">
          <h2 class="text-[17px] font-bold leading-[1.35] text-ink">General questions</h2>
          <p class="mt-2 max-w-[48ch] text-base leading-relaxed text-ink-secondary">
            For inquiries about Tech for Palestine, our projects, or how to get involved.
          </p>
          <div class="mt-5 flex items-center gap-1">
            <a
              id="contact-email"
              href="#"
              class={`inline-block min-w-0 break-words text-[22px] font-extrabold leading-snug text-grove underline decoration-grove/40 underline-offset-[6px] transition-colors hover:decoration-grove motion-reduce:transition-none min-[810px]:text-[26px] ${focusRing}`}
              >contact [at] techforpalestine [dot] org</a
            >
            <CopyEmailButton target="contact-email" />
          </div>
          <script>
            (function () {
              var el = document.getElementById("contact-email") as HTMLAnchorElement | null;
              if (!el) return;
              var e = "contact" + "@" + "techforpalestine.org";
              el.href = "mailto:" + e;
              el.textContent = e;
            })();
          </script>
        </div>
      </div>
    </section>

    <!-- Routing list -->
    <section
      aria-labelledby="routes-heading"
      class="border-y border-first-light-edge bg-first-light"
    >
      <div class={`${container} py-16 min-[810px]:py-20`}>
        <p class={overline}>Something specific?</p>
        <h2 id="routes-heading" class={`mt-4 max-w-[22ch] ${headline}`}>
          Go straight to the right place
        </h2>

        <ul class="mt-10 divide-y divide-first-light-edge border-y border-first-light-edge">
          {
            routes.map((route) => (
              <li class="grid gap-x-10 gap-y-3 py-7 md:grid-cols-[14rem_minmax(0,1fr)_auto] md:items-baseline">
                <h3
                  id={`route-${route.id}`}
                  class="text-[17px] font-bold leading-[1.35] text-ink md:text-xl"
                >
                  {route.need}
                </h3>
                <div class="max-w-[60ch]">
                  <p class="text-base leading-relaxed text-ink-secondary min-[810px]:text-lg">
                    {route.detail}
                  </p>
                  {route.email && (
                    <p class="mt-2 flex items-center gap-1 text-base leading-relaxed text-ink-secondary">
                      <span class="min-w-0">
                        Or email{" "}
                        <a
                          id={`route-email-${route.id}`}
                          href={`mailto:${route.email}`}
                          class={`break-words ${inlineLink}`}
                        >
                          {route.email}
                        </a>
                      </span>
                      <CopyEmailButton target={`route-email-${route.id}`} />
                    </p>
                  )}
                </div>
                <a href={route.href} class={routeLink} aria-describedby={`route-${route.id}`}>
                  {route.action}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="h-4 w-4 shrink-0"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page -->
    <TerminalCta heading="Want to do more than get in touch?" headingId="join-heading">
      Members fund the work and join the teams building tech for Palestinian liberation.
      <Fragment slot="actions">
        <a href="/membership" class={inverseButton}>Become a member</a>
      </Fragment>
    </TerminalCta>
  </main>
</Layout>
