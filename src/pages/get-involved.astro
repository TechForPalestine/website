---
import Layout from "../layouts/Layout.astro";
import "../styles/base.css";

const container = "mx-auto max-w-[1280px] px-6 sm:px-8";
const h2 =
  "text-[28px] font-extrabold leading-tight tracking-tight text-ink min-[810px]:text-[38px]";
const lede = "text-[19px] leading-relaxed text-ink min-[810px]:text-[21px]";
const overline = "mb-4 text-xs font-bold uppercase tracking-[0.14em] text-[#2F5C3F]";
const bandShell = "border-y border-[#D2E4D6] bg-[#E7F2E9]";
const primaryButton =
  "inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#157A3E] px-7 py-3.5 font-bold text-white shadow-sm transition-colors duration-150 hover:bg-[#0e5a2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2 motion-reduce:transition-none";
const textLink =
  "rounded-sm text-[17px] font-bold text-[#157A3E] underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-[#0e5a2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2 motion-reduce:transition-none";
// Quieter follow-up link that sits under a path's main action
const subLink =
  "rounded-sm text-[15px] text-[#157A3E] underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-[#0e5a2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#157A3E] focus-visible:ring-offset-2 motion-reduce:transition-none";

interface Path {
  title: string;
  description: string;
  action: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const paths: Path[] = [
  {
    title: "Join our Discord community",
    description:
      "Connect with thousands of pro-Palestine advocates, volunteers, and project leaders.",
    action: { label: "Join Discord", href: "https://techforpalestine.org/discord-invite" },
  },
  {
    title: "Join the Incubator",
    description:
      "Do you own or operate your own pro-Palestine project? Get mentorship, volunteers, funding, and support to bring it to life.",
    action: {
      label: "Apply to the Incubator",
      href: "https://techforpalestine.org/project-application-form",
    },
    secondary: { label: "Learn more about the Incubator", href: "/incubator" },
  },
  {
    title: "Entrepreneurs for Palestine",
    description:
      "Connect with other founders and CEOs who support the Palestinian cause. Share resources and build partnerships.",
    action: { label: "Join E4P", href: "/e4p" },
  },
  {
    title: "Hire Palestinians",
    description:
      "Looking for talented Palestinian professionals? Connect with our network of skilled people across many fields.",
    action: { label: "Find talent", href: "/help/hire" },
  },
  {
    title: "Browse project ideas",
    description: "Explore our curated list of project ideas that could use your skills.",
    action: { label: "View ideas", href: "/ideas" },
  },
];
---

<style is:global>
  /* The email form is injected by a third-party script; match it to the primary button */
  .eomail-form button[type="submit"],
  .eomail-form input[type="submit"] {
    background-color: #157a3e !important;
    color: white !important;
    border: none !important;
    min-height: 44px !important;
    padding: 0.875rem 1.75rem !important;
    border-radius: 999px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: background-color 0.15s !important;
  }

  .eomail-form button[type="submit"]:hover,
  .eomail-form input[type="submit"]:hover {
    background-color: #0e5a2f !important;
  }
</style>

<Layout title="Get Involved">
  <main>
    <!-- Hero, then the primary path: membership beside a real working session -->
    <section class={`${container} pb-16 pt-16 min-[810px]:pb-20 min-[810px]:pt-20`}>
      <div class="max-w-[760px]">
        <h1
          class="mb-6 text-[38px] font-extrabold leading-[1.05] tracking-tight text-ink min-[810px]:text-[54px] min-[810px]:leading-[1.02]"
        >
          Get involved with Tech for Palestine
        </h1>
        <p class={`max-w-[65ch] ${lede}`}>
          Volunteer, collaborate, and build for Palestinian liberation alongside a community that
          puts your skills to work.
        </p>
        <p class="mt-4 max-w-[65ch] text-[17px] leading-relaxed text-ink-secondary">
          Before you join, please read our <a
            href="https://github.com/techForPalestine/code-of-conduct"
            class={textLink}>Code of Conduct</a
          >.
        </p>
      </div>

      <div
        class="mt-14 grid grid-cols-1 items-center gap-10 rounded-lg border border-ink-divider p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14 lg:p-10"
      >
        <div>
          <p class={overline}>Start here</p>
          <h2 class={h2}>Become a Member</h2>
          <p class="mt-4 max-w-[60ch] text-[17px] leading-relaxed text-ink-secondary">
            Volunteer your expertise to pro-Palestine projects, start new projects within T4P, join
            member events &amp; the vetted member chat, and sustain our work with grassroots funding
            to keep us independent.
          </p>
          <div class="mt-8 flex flex-col items-start gap-3">
            <a href="/membership" class={primaryButton}>Become a Member</a>
            <a href="/volunteer" class={subLink}>Explore open roles</a>
          </div>
        </div>
        <img
          src="/images/new-homepage/press/team-2.webp"
          alt="Tech for Palestine members around a table at a working session, planning projects together"
          width="1600"
          height="1067"
          class="block h-auto w-full rounded-md"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <!-- Band: every other way in, one ruled row per path -->
    <section class={bandShell}>
      <div class={`${container} py-14 min-[810px]:py-16`}>
        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-16"
        >
          <div class="lg:sticky lg:top-24 lg:self-start">
            <p class={overline}>More ways in</p>
            <h2 class={`max-w-[18ch] ${h2}`}>Find the path that fits your skills</h2>
          </div>
          <ul class="border-b border-[#D2E4D6]">
            {
              paths.map((path) => (
                <li class="flex flex-col gap-4 border-t border-[#D2E4D6] py-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
                  <div class="max-w-[52ch]">
                    <h3 class="text-[19px] font-bold leading-snug text-ink">{path.title}</h3>
                    <p class="mt-1 text-[17px] leading-relaxed text-ink-secondary">
                      {path.description}
                    </p>
                  </div>
                  <div class="flex shrink-0 flex-col items-start gap-2 sm:items-end sm:pt-0.5">
                    <a href={path.action.href} class={textLink}>
                      {path.action.label} <span aria-hidden="true">→</span>
                    </a>
                    {path.secondary && (
                      <a href={path.secondary.href} class={subLink}>
                        {path.secondary.label}
                      </a>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Stay connected: heading on the left, the email form on the right -->
    <section class={`${container} py-16 min-[810px]:py-20`}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class={h2}>Get project updates</h2>
          <p class={`mt-4 max-w-[45ch] ${lede}`}>
            New project opportunities and T4P initiatives, straight to your inbox.
          </p>
        </div>
        <div class="rounded-lg border border-ink-divider bg-white p-6 shadow-sm sm:p-8">
          <script
            is:inline
            async
            src="https://eomail4.com/form/19239af2-f79d-11ef-b1dc-d39ed3d42a2b.js"
            data-form="19239af2-f79d-11ef-b1dc-d39ed3d42a2b"></script>
        </div>
      </div>
    </section>

    <!-- Terminal CTA: the one dark block on the page -->
    <section class="bg-[#101010] px-6 py-20 sm:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
        <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-white md:text-[32px]">
          Not sure which path is right for you?
        </h2>
        <p class="max-w-[50ch] text-[17px] leading-relaxed text-[#D6D6D6]">
          Tell us what you do and we'll point you to where it's needed most.
        </p>
        <a
          href="/contact"
          class="mt-2 inline-flex min-h-[44px] items-center justify-center rounded-full bg-white px-8 py-3.5 font-bold text-ink shadow-sm transition-colors duration-150 hover:bg-[#F2F3EE] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#101010] motion-reduce:transition-none"
        >
          Contact us
        </a>
      </div>
    </section>
  </main>
</Layout>
